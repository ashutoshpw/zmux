+test "Zmux metadata captures raw OSC 7501 arguments and terminators" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+    p.zmux_metadata_limit = 4096;
+
+    const arguments = "state=working:id=worker:app=build_tool=x";
+    for ("7501;" ++ arguments) |byte| p.next(byte);
+    const bel = p.end(std.ascii.control_code.bel).?.*;
+    try testing.expect(bel == .zmux_metadata);
+    try testing.expectEqual(@as(u32, 7501), bel.zmux_metadata.source);
+    try testing.expectEqual(@as(u32, 0), bel.zmux_metadata.status);
+    try testing.expectEqual(@as(u32, 7), bel.zmux_metadata.terminator);
+    try testing.expectEqualStrings(arguments, bel.zmux_metadata.payload);
+
+    p.reset();
+    const split_arguments = "state=blocked:kind=question:id=dialog";
+    p.nextSlice("7501;");
+    p.nextSlice("state=blocked:kind=");
+    p.nextSlice("question:id=dialog");
+    const st = p.end(std.ascii.control_code.esc).?.*;
+    try testing.expect(st == .zmux_metadata);
+    try testing.expectEqual(@as(u32, 7501), st.zmux_metadata.source);
+    try testing.expectEqual(@as(u32, 27), st.zmux_metadata.terminator);
+    try testing.expectEqualStrings(split_arguments, st.zmux_metadata.payload);
+}
