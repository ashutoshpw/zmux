+test "zmux metadata captures raw OSC, prompt and RIS without replacing callbacks" {
+    const Capture = struct {
+        const Self = @This();
+
+        count: usize = 0,
+        sources: [8]u32 = undefined,
+        subcommands: [8]u32 = undefined,
+        statuses: [8]u32 = undefined,
+        terminators: [8]u32 = undefined,
+        payloads: [8][128]u8 = undefined,
+        payload_lengths: [8]usize = undefined,
+        replies: [256]u8 = undefined,
+        reply_length: usize = 0,
+        prompt_callback_count: usize = 0,
+        reset_callback_count: usize = 0,
+
+        fn metadata(ctx: ?*anyopaque, value: *const osc.ZmuxMetadata.C) callconv(lib.calling_conv) void {
+            const self: *Self = @ptrCast(@alignCast(ctx.?));
+            if (self.count >= self.sources.len or value.payload.len > self.payloads[0].len)
+                @panic("test capture capacity exceeded");
+            const index = self.count;
+            self.sources[index] = value.source;
+            self.subcommands[index] = value.subcommand;
+            self.statuses[index] = value.status;
+            self.terminators[index] = value.terminator;
+            self.payload_lengths[index] = value.payload.len;
+            @memcpy(self.payloads[index][0..value.payload.len], value.payload.ptr[0..value.payload.len]);
+            self.count += 1;
+        }
+
+        fn writePty(_: Terminal, ctx: ?*anyopaque, ptr: [*]const u8, len: usize) callconv(lib.calling_conv) void {
+            const self: *Self = @ptrCast(@alignCast(ctx.?));
+            if (len > self.replies.len - self.reply_length) @panic("test reply capture capacity exceeded");
+            @memcpy(self.replies[self.reply_length..][0..len], ptr[0..len]);
+            self.reply_length += len;
+        }
+
+        fn semanticPrompt(_: Terminal, ctx: ?*anyopaque, event: *const SemanticPrompt) callconv(lib.calling_conv) void {
+            const self: *Self = @ptrCast(@alignCast(ctx.?));
+            if (event.kind == SemanticPromptKind.prompt_start) self.prompt_callback_count += 1;
+        }
+
+        fn reset(_: Terminal, ctx: ?*anyopaque) callconv(lib.calling_conv) void {
+            const self: *Self = @ptrCast(@alignCast(ctx.?));
+            self.reset_callback_count += 1;
+        }
+    };
+
+    var capture: Capture = .{};
+    var t: Terminal = null;
+    const allocator = &lib.alloc.test_allocator;
+    try testing.expectEqual(Result.success, zmux_new_metadata_bounded(
+        allocator,
+        allocator,
+        &t,
+        80,
+        24,
+        100,
+        4096,
+        &capture,
+        &Capture.metadata,
+    ));
+    defer free(t);
+    try testing.expectEqual(Result.success, set(t, .userdata, @ptrCast(&capture)));
+    try testing.expectEqual(Result.success, set(t, .write_pty, @ptrCast(&Capture.writePty)));
+    try testing.expectEqual(Result.success, set(t, .semantic_prompt, @ptrCast(&Capture.semanticPrompt)));
+    try testing.expectEqual(Result.success, set(t, .reset, @ptrCast(&Capture.reset)));
+
+    const bel = "\x1b]7501;state=working:id=worker\x07";
+    vt_write(t, bel.ptr, bel.len);
+    try testing.expectEqual(@as(usize, 1), capture.count);
+    try testing.expectEqual(@as(u32, 7501), capture.sources[0]);
+    try testing.expectEqual(@as(u32, 7), capture.terminators[0]);
+    try testing.expectEqualStrings("state=working:id=worker", capture.payloads[0][0..capture.payload_lengths[0]]);
+
+    // ST may split at any PTY read boundary. The ESC is withheld until the
+    // following byte confirms the backslash terminator.
+    const split_st_prefix = "\x1b]7501;state=done:id=worker\x1b";
+    vt_write(t, split_st_prefix.ptr, split_st_prefix.len);
+    try testing.expectEqual(@as(usize, 1), capture.count);
+    vt_write(t, "\\", 1);
+    try testing.expectEqual(@as(usize, 2), capture.count);
+    try testing.expectEqual(@as(u32, 27), capture.terminators[1]);
+    try testing.expectEqualStrings("state=done:id=worker", capture.payloads[1][0..capture.payload_lengths[1]]);
+
+    // A bare ESC cancels this OSC 7501 report and resumes the existing CSI
+    // parser for the following bytes.
+    const invalid_st = "\x1b]7501;state=error:id=discard\x1b[31m";
+    vt_write(t, invalid_st.ptr, invalid_st.len);
+    try testing.expectEqual(@as(usize, 3), capture.count);
+    try testing.expectEqual(@as(u32, 7501), capture.sources[2]);
+    try testing.expectEqual(@as(u32, 1), capture.statuses[2]);
+    try testing.expectEqual(@as(u32, 24), capture.terminators[2]);
+
+    const query_and_da = "\x1b]7501;?\x07\x1b[c";
+    vt_write(t, query_and_da.ptr, query_and_da.len);
+    try testing.expectEqual(@as(usize, 4), capture.count);
+    try testing.expectEqualStrings("?", capture.payloads[3][0..capture.payload_lengths[3]]);
+    const expected_reply = "\x1b]7501;" ++ osc.program_status.query_reply ++ "\x07\x1b[?62;22c";
+    try testing.expectEqualStrings(expected_reply, capture.replies[0..capture.reply_length]);
+
+    const prompt = "\x1b]133;A\x07";
+    vt_write(t, prompt.ptr, prompt.len);
+    try testing.expectEqual(@as(usize, 5), capture.count);
+    try testing.expectEqual(@as(u32, 133), capture.sources[4]);
+    try testing.expectEqual(@as(u32, 1), capture.subcommands[4]);
+    try testing.expectEqual(@as(usize, 1), capture.prompt_callback_count);
+
+    const decstr = "\x1b[!p";
+    vt_write(t, decstr.ptr, decstr.len);
+    try testing.expectEqual(@as(usize, 5), capture.count);
+    try testing.expectEqual(@as(usize, 0), capture.reset_callback_count);
+
+    const ris = "\x1bc";
+    vt_write(t, ris.ptr, ris.len);
+    try testing.expectEqual(@as(usize, 6), capture.count);
+    try testing.expectEqual(@as(u32, 133), capture.sources[5]);
+    try testing.expectEqual(@as(u32, 2), capture.subcommands[5]);
+    try testing.expectEqual(@as(usize, 1), capture.reset_callback_count);
+}
