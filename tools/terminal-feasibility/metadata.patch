--- /dev/null
+++ b/include/ghostty/vt/zmux_metadata.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: MIT
+// Original Zmux isolated experiment. Unstable, separately versioned from upstream.
+#ifndef ZMUX_GHOSTTY_METADATA_V1_H
+#define ZMUX_GHOSTTY_METADATA_V1_H
+#include <ghostty/vt.h>
+typedef struct {
+  size_t size;
+  uint32_t source, subcommand, status, terminator;
+  GhosttyString payload;
+} ZmuxGhosttyMetadataV1;
+// Borrowed descriptor/payload last for this call only. No reentry or allocation
+// is required to report status. 0 complete, 1 aborted, 2 malformed, 3 limit, 4 OOM.
+typedef void (*ZmuxGhosttyMetadataCallbackV1)(void *, const ZmuxGhosttyMetadataV1 *);
+// Cap includes OSC number/first delimiter/payload; excludes framing/sentinel.
+// Set policy before any engine byte. Callback context outlives terminal teardown.
+GHOSTTY_API GhosttyResult zmux_ghostty_terminal_new_metadata_bounded_v1(
+  const GhosttyAllocator *, const GhosttyAllocator *, GhosttyTerminal *,
+  uint16_t, uint16_t, size_t, size_t, void *, ZmuxGhosttyMetadataCallbackV1);
+#endif
