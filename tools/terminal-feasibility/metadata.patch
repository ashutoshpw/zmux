+// Original experimental v1 ABI: policy is fixed before the first engine byte.
+pub fn zmux_new_metadata_bounded(
+    alloc_: *const CAllocator,
+    page_alloc: *const CAllocator,
+    result: *Terminal,
+    cols: size.CellCountInt,
+    rows: size.CellCountInt,
+    history: usize,
+    cap: usize,
+    ctx: ?*anyopaque,
+    callback: ?*const fn (?*anyopaque, *const osc.ZmuxMetadata.C) callconv(lib.calling_conv) void,
+) callconv(lib.calling_conv) Result {
+    result.* = null;
+    if (cap < 4 or cap > 16384 or callback == null) return .invalid_value;
+    const status = zmux_new_bounded(alloc_, page_alloc, result, cols, rows, history);
+    if (status != .success) return status;
+    const wrapper = result.*.?;
+    wrapper.zmux_metadata_ctx = ctx;
+    wrapper.zmux_metadata_callback = callback;
+    wrapper.stream.parser.osc_parser.zmux_metadata_limit = cap;
+    wrapper.stream.handler.effects.zmux_metadata = &zmuxMetadataTrampoline;
+    // Only OSC 7 is an accepted migration cwd source. Other upstream PWD
+    // sources remain explicitly ignored and cannot populate clipped getters.
+    return .success;
+}
+fn zmuxMetadataTrampoline(handler: *Handler, value: osc.ZmuxMetadata) void {
+    const wrapper = TerminalWrapper.fromHandler(handler);
+    const callback = wrapper.zmux_metadata_callback orelse return;
+    var event = value.cval();
+    callback(wrapper.zmux_metadata_ctx, &event);
+}
+
 // Exercise real Screen/PageList clone ownership through the experiment ABI.
