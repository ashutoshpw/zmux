+// Original Zmux experimental constructor. Dedicated page mappings must be zeroed
+// and page-aligned. The caller keeps both allocator contexts alive through free.
+pub fn zmux_new_bounded(
+    alloc_: *const CAllocator,
+    page_alloc: *const CAllocator,
+    result: *Terminal,
+    cols: size.CellCountInt,
+    rows: size.CellCountInt,
+    history: usize,
+) callconv(lib.calling_conv) Result {
+    result.* = null;
+    if (cols == 0 or cols > 240 or rows == 0 or rows > 120 or history > 1000)
+        return .invalid_value;
+    result.* = newWithPolicy_(alloc_, cols, rows, lib.alloc.default(page_alloc), history) catch |err| {
+        return switch (err) {
+            error.InvalidValue => .invalid_value,
+            error.OutOfMemory => .out_of_memory,
+        };
+    };
+    return .success;
+}
+
+// Exercise real Screen/PageList clone ownership through the experiment ABI.
+pub fn zmux_clone_storage(terminal_: Terminal, history: *usize) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const t = wrapper.terminal;
+    var copy = t.screens.active.clone(t.io(), t.gpa(), .{ .screen = .{} }, null) catch
+        return .out_of_memory;
+    defer copy.deinit();
+    history.* = copy.pages.total_rows - copy.pages.rows;
+    return .success;
+}
+
 fn new_(
     alloc_: ?*const CAllocator,
