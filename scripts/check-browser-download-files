#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ "$(uname -s)" != Darwin ]; then
    echo 'Browser download file acceptance requires macOS.' >&2
    exit 1
fi
scratch=$(mktemp -d /tmp/zmux-download-files.XXXXXX)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
xcrun swiftc -parse-as-library -swift-version 6 -strict-concurrency=complete -warnings-as-errors \
    apps/macos/Sources/BrowserDownloadFiles.swift tools/native-fixtures/download-files.swift \
    -o "$scratch/download-files"
"$scratch/download-files"
