#!/usr/bin/env python3
"""Exercise compact toolbar and grouping through an isolated packaged native app."""
from pathlib import Path
import argparse
import hashlib
import json
import os
import platform
import socket
import signal
import struct
import subprocess
import tempfile
import threading
import time
import uuid


def recv_exact(connection, length):
    chunks = bytearray()
    while len(chunks) < length:
        chunk = connection.recv(length - len(chunks))
        if not chunk:
            raise RuntimeError("Control socket closed before the complete response arrived")
        chunks.extend(chunk)
    return bytes(chunks)


def control_request(path, request_id, command):
    encoded = json.dumps({"version": 2, "request_id": request_id, "command": command},
                         separators=(",", ":")).encode()
    if len(encoded) > 16_384:
        raise RuntimeError("Agent lifecycle smoke request exceeds the control socket bound")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(5)
        connection.connect(path)
        connection.sendall(struct.pack("!I", len(encoded)) + encoded)
        response_size = struct.unpack("!I", recv_exact(connection, 4))[0]
        if not 1 <= response_size <= 1_048_576:
            raise RuntimeError("Agent lifecycle smoke response exceeds the control socket bound")
        response = json.loads(recv_exact(connection, response_size))
    if response.get("ok") is not True:
        failure = response.get("error", {})
        raise RuntimeError("Desktop refused agent lifecycle fixture: " + str(failure.get("message", "unknown error")))
    if response.get("version") != 2 or response.get("request_id") != request_id:
        raise RuntimeError("Desktop returned a mismatched agent lifecycle control response")
    return response.get("result")


def seed_sidebar_agent(target_path, socket_path, receipt_path, stop_event, result):
    deadline = time.monotonic() + 120
    while not stop_event.is_set() and not target_path.exists():
        if time.monotonic() >= deadline:
            result["error"] = "Packaged app did not publish an exact terminal target for the lifecycle fixture"
            return
        time.sleep(0.05)
    if stop_event.is_set():
        return
    try:
        if target_path.is_symlink() or not target_path.is_file():
            raise RuntimeError("Agent lifecycle target manifest is not a regular fixture file")
        manifest = json.loads(target_path.read_text())
        target = manifest.get("target")
        expected_owner = manifest.get("expected_owner")
        if not isinstance(target, dict) or not isinstance(expected_owner, dict):
            raise RuntimeError("Agent lifecycle target manifest is incomplete")
        required = ("identity_namespace", "surface_id", "surface_uuid", "session_id")
        if any(key not in target for key in required):
            raise RuntimeError("Agent lifecycle target manifest is incomplete")
        runtime_id, generation, provider_session_id, prompt_id = (str(uuid.uuid4()) for _ in range(4))
        registration = control_request(socket_path, 1, {"method": "agent_lifecycle", "request": {
            "request_id": str(uuid.uuid4()),
            "action": {"action": "register", "target": target, "provider": "claude_local",
                       "runtime_id": runtime_id, "generation": generation,
                       "provider_session_id": provider_session_id}
        }})
        capability = registration.get("capability") if isinstance(registration, dict) else None
        if not isinstance(registration, dict) or registration.get("accepted") is not True or not capability:
            raise RuntimeError("Desktop did not acknowledge agent lifecycle registration")
        event = control_request(socket_path, 2, {"method": "agent_lifecycle", "request": {
            "request_id": str(uuid.uuid4()),
            "action": {"action": "event", "capability": capability, "runtime_id": runtime_id,
                       "generation": generation, "sequence": 1,
                       "event": {"event": "prompt_submitted", "prompt_id": prompt_id}}
        }})
        if not isinstance(event, dict) or event.get("accepted") is not True:
            raise RuntimeError("Desktop did not acknowledge the PromptSubmitted lifecycle event")
        evidence = {"success": True, "source": "same_uid_v2_control_socket",
                    "registration_accepted": True, "event_accepted": True,
                    "event": "prompt_submitted", "sequence": 1, "target": target,
                    "expected_owner": {**expected_owner, "runtime_id": runtime_id,
                                       "generation": generation, "provider_session_id": provider_session_id},
                    "runtime_id": runtime_id, "generation": generation,
                    "provider_session_id": provider_session_id, "prompt_id": prompt_id}
        temporary = receipt_path.with_suffix(receipt_path.suffix + ".tmp")
        temporary.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n")
        temporary.replace(receipt_path)
        result["success"] = True
    except Exception as error:
        result["error"] = str(error)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--skip-build", action="store_true", help="Use the existing development bundle")
    parser.add_argument("--architecture", choices=["universal", "host"], default="universal")
    args = parser.parse_args()
    if platform.system() != "Darwin":
        raise SystemExit("Native sidebar acceptance requires macOS")
    root = Path(__file__).resolve().parent.parent
    if not args.skip_build:
        subprocess.run([str(root / "scripts/build-macos-dev"), "--architecture", args.architecture], cwd=root, check=True)
    dist = root / "dist"
    bundle = dist / "zmux.app"
    executable = bundle / "Contents/MacOS/zmux-app"
    metadata = json.loads((dist / "build-info.json").read_text())
    source_sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    if metadata["source_sha"] != source_sha:
        raise RuntimeError("Packaged app does not match the current source commit")
    expected_architectures = ({"arm64", "x86_64"} if args.architecture == "universal"
                              else {"arm64" if platform.machine() == "arm64" else "x86_64"})
    if set(metadata["architectures"]) != expected_architectures:
        raise RuntimeError("Sidebar package architectures do not match the requested build")
    directory = Path(tempfile.mkdtemp(prefix="zms-", dir="/tmp")).resolve()
    directory.chmod(0o700)
    socket = directory / "c"
    report = dist / "native-sidebar.json"
    receipt = dist / "native-sidebar-process.json"
    lifecycle = dist / "native-sidebar-lifecycle.json"
    agent_target = dist / "sidebar-agent-target.tmp.json"
    agent_fixture = dist / "native-sidebar-agent-fixture.json"
    status_report = dist / "native-status-menu.json"
    nonce = str(uuid.uuid4())
    screenshots = [dist / "zmux-sidebar.png", dist / "zmux-sidebar-collapsed.png",
                   dist / "zmux-sidebar-agents.png", dist / "zmux-status-icon.png"]
    for path in [report, receipt, lifecycle, agent_target, agent_fixture, status_report, *screenshots]:
        path.unlink(missing_ok=True)
    # Keep the actual HOME for macOS services. Profile/session storage and the
    # socket are explicit generated fixture paths, never the user's app state.
    environment = {key: os.environ[key] for key in
                   ("HOME", "USER", "LOGNAME", "PATH", "TMPDIR", "LANG", "LC_ALL", "__CF_USER_TEXT_ENCODING")
                   if key in os.environ}
    process = None
    agent_stop = threading.Event()
    agent_fixture_result = {}
    agent_thread = None
    evidence = {"success": False, "source_sha": metadata["source_sha"],
                "fixture_directory": str(directory), "socket_path": str(socket),
                "architectures": metadata["architectures"], "nonce": nonce,
                "app_pid_absent": False, "physical_cleanup_complete": False,
                "packaged_executable_sha256": hashlib.sha256(executable.read_bytes()).hexdigest(),
                "environment": "Allowlisted OS environment; explicit isolated profile and control socket"}
    try:
        command = ["/usr/bin/open", "-n", "-W",
                   "--stdout", str(dist / "native-sidebar.stdout.log"),
                   "--stderr", str(dist / "native-sidebar.stderr.log"),
                   "--env", "ZMUX_SOCKET=" + str(socket),
                   "--env", "ZMUX_SOCKET_PATH=" + str(socket),
                   "--env", "ZMUX_SIDEBAR_NONCE=" + nonce,
                   str(bundle), "--args", "--sidebar-grouping-smoke", str(report),
                   str(directory / "profile")]
        agent_thread = threading.Thread(target=seed_sidebar_agent,
                                        args=(agent_target, str(socket), agent_fixture, agent_stop, agent_fixture_result),
                                        name="native-sidebar-agent-fixture", daemon=True)
        agent_thread.start()
        with (dist / "native-sidebar-driver.stdout.log").open("wb") as output, \
                (dist / "native-sidebar-driver.stderr.log").open("wb") as errors:
            process = subprocess.Popen(command, cwd=root, env=environment,
                                       stdin=subprocess.DEVNULL, stdout=output, stderr=errors,
                                       start_new_session=True)
            evidence["launch_driver_pid"] = process.pid
            try:
                status = process.wait(timeout=150)
            except subprocess.TimeoutExpired as error:
                evidence["timed_out"] = True
                # This is only our open(1) driver, not the app Launch Services
                # owns. Do not signal an app whose identity is unverified.
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait(timeout=5)
                raise RuntimeError("Sidebar Launch Services driver exceeded its 150 second deadline; app cleanup unconfirmed") from error
        evidence.update(launch_driver_exit_status=status, launch_driver_waited_and_reaped=True,
                        owned_socket_absent=not socket.exists())
        if status != 0:
            raise RuntimeError(f"Sidebar Launch Services driver exited with status {status}")
        agent_stop.set()
        agent_thread.join(timeout=5)
        if agent_thread.is_alive():
            raise RuntimeError("Agent lifecycle fixture thread did not stop after app exit")
        if agent_fixture_result.get("error"):
            raise RuntimeError("Agent lifecycle fixture failed: " + agent_fixture_result["error"])
        if agent_fixture_result.get("success") is not True or not agent_fixture.is_file():
            raise RuntimeError("Agent lifecycle fixture did not publish an accepted registration/event receipt")
        identity = json.loads(lifecycle.read_text())
        evidence["app_lifecycle"] = identity
        if identity.get("nonce") != nonce or identity.get("source_sha") != source_sha:
            raise RuntimeError("Sidebar app lifecycle identity does not match this launch")
        app_pid = identity.get("app_pid")
        if type(app_pid) is not int or app_pid <= 1 or app_pid == process.pid:
            raise RuntimeError("Sidebar lifecycle does not identify a distinct valid app PID")
        evidence["app_pid"] = app_pid
        if identity.get("physical_cleanup_complete") is not True:
            raise RuntimeError("Sidebar app did not confirm physical cleanup")
        evidence["physical_cleanup_complete"] = True
        deadline = time.monotonic() + 5
        while True:
            try:
                os.kill(app_pid, 0)
            except ProcessLookupError:
                evidence["app_pid_absent"] = True
                break
            # A live or reused PID is never treated as confirmed app exit and
            # never signalled. Permission errors also fail closed.
            if time.monotonic() >= deadline:
                raise RuntimeError("Sidebar app PID remains present after driver exit; PID reuse or cleanup unconfirmed")
            time.sleep(0.05)
        if socket.exists():
            raise RuntimeError("Sidebar fixture exited without removing its owned control socket")
        if not report.is_file():
            raise RuntimeError("Native sidebar/status assertions did not publish a success receipt; inspect native-sidebar.stderr.log")
        result = json.loads(report.read_text())
        required = ("compact_toolbar", "visible_toggle", "groups", "group_menus",
                    "collapse_preserves_terminal", "focus_preserved", "sidebar_restored",
                    "notification_toggle", "window_scoping", "native_terminal_damage",
                    "agent_lifecycle_connected_working", "agent_row_visible",
                    "agent_selection_started_in_other_workspace", "agent_selection_exact_identity",
                    "agent_no_new_surface_or_session")
        failed = [key for key in required if result.get(key) is not True]
        if failed:
            raise RuntimeError("Sidebar acceptance failed: " + ", ".join(failed))
        status_result = json.loads(status_report.read_text())
        required_status = ("native_status_button", "system_menu_opened", "workspace_context_actions",
                           "captured_mutations", "cross_window_notification_open", "inbox_presentation",
                           "minimized_window_restore", "keep_awake_toggle", "single_application_owner")
        required_status += ("hidden_window_recovery",)
        failed_status = [key for key in required_status if status_result.get(key) is not True]
        if failed_status:
            raise RuntimeError("Native status menu acceptance failed: " + ", ".join(failed_status))
        for path in screenshots:
            if not path.is_file() or path.stat().st_size == 0:
                raise RuntimeError(f"Missing native screenshot: {path.name}")
        agent_result = json.loads(agent_fixture.read_text())
        owner = result.get("agent_identity")
        target = agent_result.get("target")
        expected_owner = agent_result.get("expected_owner")
        if not isinstance(owner, dict) or not isinstance(target, dict) or not isinstance(expected_owner, dict):
            raise RuntimeError("Agent lifecycle acceptance omitted the exact target identity")
        for key in ("identity_namespace", "surface_id", "surface_uuid", "session_id"):
            if str(owner.get(key)).lower() != str(target.get(key)).lower():
                raise RuntimeError("Packaged UI lifecycle owner does not match the socket fixture target: " + key)
        for key in ("provider", "identity_namespace", "window_id", "window_uuid", "workspace_id",
                    "workspace_uuid", "pane_id", "pane_uuid", "surface_id", "surface_uuid",
                    "session_id", "runtime_id", "generation", "provider_session_id"):
            if str(owner.get(key)).lower() != str(expected_owner.get(key)).lower():
                raise RuntimeError("Rust-published lifecycle owner does not match the exact current owner: " + key)
        if (owner.get("provider") != "claude_local" or owner.get("connection") != "connected"
                or owner.get("activity") != "working" or owner.get("prompt_id_present") is not True
                or agent_result.get("registration_accepted") is not True
                or agent_result.get("event_accepted") is not True):
            raise RuntimeError("Packaged UI lifecycle receipt does not match accepted Connected/Working evidence")
        evidence.update(success=True, native=result, status_menu=status_result, agent_fixture=agent_result)
        print("Native sidebar/grouping and populated agent selection checks, correlated app cleanup and PID absence passed")
    except Exception as error:
        evidence["error"] = str(error)
        raise
    finally:
        agent_stop.set()
        if agent_thread is not None:
            agent_thread.join(timeout=5)
        agent_target.unlink(missing_ok=True)
        receipt.write_text(json.dumps(evidence, indent=2) + "\n")


if __name__ == "__main__":
    main()
