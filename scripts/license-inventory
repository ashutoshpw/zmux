#!/usr/bin/env python3
"""Inventory resolved Rust dependencies and retain available package license texts."""
from pathlib import Path
import hashlib
import json
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
metadata = json.loads(subprocess.check_output(
    ["cargo", "metadata", "--format-version", "1", "--locked"], cwd=root, text=True
))
packages = sorted((p for p in metadata["packages"] if p["source"]), key=lambda p: (p["name"], p["version"]))
lines = ["# Third-party Rust notices", "", "Generated by `scripts/license-inventory` from `Cargo.lock` and registry packages.",
         "Original Zmux code is MIT; dependency licenses and notices remain their own.",
         "This retains available top-level license files. It does not replace a release audit",
         "of file-level notices, native binaries, assets, or separately installed software.", "",
         "| Package | Version | Declared license | Upstream |", "| --- | --- | --- | --- |"]
texts = {}
missing = []
for package in packages:
    label = f'{package["name"]} {package["version"]}'
    lines.append(f'| `{package["name"]}` | {package["version"]} | {package["license"] or "UNSPECIFIED"} | {package.get("repository") or "https://crates.io/crates/" + package["name"]} |')
    directory = Path(package["manifest_path"]).parent
    found = []
    for path in sorted(directory.iterdir()):
        if path.is_file() and path.name.upper().startswith(("LICENSE", "COPYING", "COPYRIGHT", "NOTICE")):
            found.append(path)
            text = path.read_text()
            digest = hashlib.sha256(text.encode()).hexdigest()
            entry = texts.setdefault(digest, {"text": text, "sources": []})
            entry["sources"].append(f'{label}: `{path.name}`')
    if not found:
        missing.append(label)
lines += ["", "## License material", ""]
for entry in texts.values():
    lines.extend(["Applies to: " + "; ".join(entry["sources"]), "", "```text", entry["text"].rstrip("\n"), "```", ""])
if missing:
    lines += ["## Packages without bundled top-level license text", "", "Review these upstream before distribution:", ""]
    lines += [f"- {label}" for label in missing]
    lines.append("")
rendered = "\n".join(lines)
out = root / "THIRD_PARTY_NOTICES.md"
if sys.argv[1:] == ["--check"]:
    if not out.exists() or out.read_text() != rendered:
        raise SystemExit("Dependency notices are stale; run scripts/license-inventory")
elif sys.argv[1:]:
    raise SystemExit("Usage: scripts/license-inventory [--check]")
else:
    out.write_text(rendered)
print(f'Inventoried {len(packages)} resolved packages, {len(texts)} distinct notice texts; {len(missing)} require upstream text review.')
