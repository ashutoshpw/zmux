#!/usr/bin/env python3
"""Exercise original browser automation scripts in a real DOM, independently of WebKit.

Requires Chromium (CHROMIUM or --browser). This does not establish native bridge,
isolated-world or WebKit lifecycle correctness; packaged macOS smoke owns those.
"""
import argparse
import html
import http.server
import json
import os
from pathlib import Path
import re
import shutil
import threading
import tempfile
from browser_process import run_browser

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--browser', default=os.environ.get('CHROMIUM', shutil.which('chromium')))
args = parser.parse_args()
if not args.browser:
    parser.error('Chromium is required; set CHROMIUM or --browser')
try:
    version_result = run_browser([args.browser, '--version'], timeout=5)
except (OSError, RuntimeError) as error:
    raise SystemExit(f'Cannot identify DOM browser {args.browser}: {error}') from error
version = (version_result.stdout or version_result.stderr).strip()[:256]
if version_result.returncode or version_result.timed_out or version_result.output_truncated or not version:
    raise SystemExit('Cannot identify DOM browser: ' + json.dumps({
        'requested_executable': args.browser,
        'resolved_executable': str(Path(args.browser).resolve()),
        'arguments': ['--version'], 'timeout_seconds': 5,
        'exit_code': version_result.returncode, 'timed_out': version_result.timed_out,
        'output_truncated': version_result.output_truncated,
        'stdout_bytes_seen': version_result.stdout_bytes_seen,
        'stderr_bytes_seen': version_result.stderr_bytes_seen,
        'stdout': version_result.stdout, 'stderr': version_result.stderr,
    }, ensure_ascii=True))
print(f'DOM browser: {version}', flush=True)

root = Path(__file__).resolve().parent.parent
swift = (root / 'apps/macos/Sources/BrowserAutomation.swift').read_text()
source = swift.split('static let source = #"""\n', 1)[1].split('\n    """#', 1)[0]
keyboard_arm = swift.split('static let armKeyboardObservation = #"""\n', 1)[1].split('\n    """#', 1)[0]
# Extraction runs the production-owned script unchanged. Expectations below are
# public locator/readiness examples, not copies of its private helper algorithms.
suite = r'''
const runScript = new (Object.getPrototypeOf(async function(){}).constructor)('payload', SOURCE);
const armKeyboard = new (Object.getPrototypeOf(async function(){}).constructor)('payload', KEYBOARD_ARM);
let generation = '1', passed = 0;
const call = async action => JSON.parse(await runScript(JSON.stringify({action, host_id:'fixture', document_generation:generation})));
const assert = (condition, label, diagnostic) => { if (!condition) throw new Error(label + (diagnostic ? ': ' + JSON.stringify(diagnostic()) : '')); passed++; };
const find = async locator => call({action:'find',locator});
const wait = async (selector,state='visible') => call({action:'wait',selector,state});
const code = (result, expected) => assert(result.error?.code === expected, `expected ${expected}: ${JSON.stringify(result)}`);
(async () => {
 // Native focus events require a loaded, focused browsing context. Starting
 // during parser execution can change activeElement without emitting focus.
 const startupDeadline = performance.now() + 2000;
 while (document.readyState !== 'complete' || !document.hasFocus()) {
   window.focus();
   if (performance.now() >= startupDeadline) throw new Error('DOM fixture could not establish loaded document focus: ' + JSON.stringify({readyState:document.readyState,visibility:document.visibilityState,hasFocus:document.hasFocus()}));
   await new Promise(resolve => setTimeout(resolve, 10));
 }

 // Page-created events cannot acknowledge native input. This real-DOM negative
 // contract protects the observer's trust/identity boundary, not WebKit delivery.
 const expectedKeys = ['keydown','keyup'].map(type => ({type,key:'x',shift:false,control:false,alt:false,meta:false}));
 const arm = token => armKeyboard(JSON.stringify({token,expected:expectedKeys,timeout_ms:25}));
 const native = token => runScript(JSON.stringify({action:{action:'keyboard',operation:'press',key:'x'},host_id:'fixture',document_generation:generation,native_keyboard:true,keyboard_observation_token:token})).then(JSON.parse);
 await arm('untrusted');
 const untrustedNative = native('untrusted');
 for (const type of ['keydown','keyup']) document.body.dispatchEvent(new KeyboardEvent(type,{key:'x',bubbles:true}));
 code(await untrustedNative,'native_input_unacknowledged');
 await arm('owner');
 code(await native('other-owner'),'native_input_unacknowledged');
 const replacedNative = native('owner');
 await arm('replacement');
 code(await replacedNative,'native_input_unacknowledged');
 code(await native('replacement'),'native_input_unacknowledged');

 // Opaque compatibility keys are explicitly synthetic and cannot invent native defaults.
 document.body.innerHTML='<input id="opaque-entry" value="unchanged">';
 const opaqueEntry=document.getElementById('opaque-entry');opaqueEntry.focus();
 const opaqueEvents=[];
 for(const type of ['keydown','keypress','keyup'])opaqueEntry.addEventListener(type,event=>opaqueEvents.push({type:event.type,key:event.key,trusted:event.isTrusted}));
 const opaque=await call({action:'keyboard',operation:'press',key:'OpaqueKeyboardToken',snapshot_after:true});
 assert(opaque.value?.dispatched===true && opaque.value.input==='synthetic' && opaque.value.native_defaults===false && opaque.snapshot?.nodes.length>0,'opaque receipt is explicit and snapshots without replay');
 assert(opaqueEntry.value==='unchanged' && opaqueEvents.map(event=>event.type).join(',')==='keydown,keyup' && opaqueEvents.every(event=>event.key==='OpaqueKeyboardToken'&&!event.trusted),'opaque input cannot claim trusted/native defaults');
 await call({action:'keyboard',operation:'down',key:'OpaqueKeyboardToken'});
 assert(opaqueEvents.map(event=>event.type).join(',')==='keydown,keyup,keydown','opaque keydown does not invent keyup');
 await call({action:'keyboard',operation:'up',key:'OpaqueKeyboardToken'});
 assert(opaqueEvents.map(event=>event.type).join(',')==='keydown,keyup,keydown,keyup','opaque keyup is delivered once');
 document.body.innerHTML = `<main>
 <label for="entry">  Account\n name </label><input id="entry" placeholder="Your account" data-testid="user-entry">
 <button id="send" aria-labelledby="send-label">Ignored text</button><span id="send-label">Send   now</span>
 <a href="/">Documentation</a><img alt="Brand badge" title="Company mark">
 <div role="button link" aria-label="Custom action" id="custom"></div>
 <div id="nested"><span>Unique   nested content</span></div>
 <button class="many">Repeated</button><button class="many">Repeated</button>
 <div id="hidden" style="display:none">Hidden content</div>
 <input type="checkbox" checked id="check"><fieldset disabled><input id="disabled"></fieldset>
 <textarea aria-label="Notes"></textarea><input type="color" id="color"><img title="Fallback image" id="fallback"><script type="text/plain">Excluded script locator text</script><select multiple id="choices"><option>One</option></select>
 </main>`;
 code(await find({kind:'text',query:'Excluded script locator text',exact:false}), 'element_not_found');
 assert((await find({kind:'first',selector:'#color'})).value?.role === '', 'color input is not textbox');
 assert((await find({kind:'title',query:'Fallback image',exact:true})).value?.name === 'Fallback image', 'image title fallback');
 const button = await find({kind:'role',query:'button',name:'Send now',exact:true});
 assert(button.value?.name === 'Send now' && button.value?.role === 'button', 'aria-labelledby role/name');
 assert((await call({action:'get',kind:'text',selector:button.value.ref})).value === 'Ignored text', 'find ref can be reused');
 assert((await find({kind:'label',query:'account\u0085name',exact:false})).value?.ref === (await find({kind:'placeholder',query:'Your account',exact:true})).value?.ref, 'associated label normalizes whitespace');
 assert((await find({kind:'testid',query:'user-entry',exact:true})).value?.role === 'textbox', 'test id');
 assert((await find({kind:'alt',query:'brand',exact:false})).value?.role === 'image', 'alt substring');
 assert((await find({kind:'title',query:'Company mark',exact:true})).value?.name === 'Brand badge', 'image alt precedes title');
 assert((await find({kind:'role',query:'BUTTON',name:'Custom action',exact:true})).value?.name === 'Custom action', 'explicit first role token');
 const nested = await find({kind:'text',query:'unique nested',exact:false});
 assert(nested.value?.text === 'Unique nested content' && (await call({action:'get',kind:'html',selector:nested.value.ref})).value.startsWith('<span>'), 'innermost text');
 code(await find({kind:'text',query:'Unique nested Content',exact:true}), 'element_not_found');
 code(await find({kind:'text',query:'Repeated',exact:true}), 'ambiguous_locator');
 const first = await find({kind:'first',selector:'.many'}), last = await find({kind:'last',selector:'.many'});
 assert(first.value.ref !== last.value.ref && (await find({kind:'nth',selector:'.many',index:1})).value.ref === last.value.ref, 'ordered selection');
 code(await find({kind:'nth',selector:'.many',index:2}), 'element_not_found');
 code(await find({kind:'first',selector:'['}), 'invalid_selector');
 code(await wait('.many'), 'ambiguous_locator');
 assert((await find({kind:'text',query:'Hidden content',exact:true})).value?.ref != null, 'hidden discovery');
 for (const [selector,state,expected] of [
 ['#hidden','visible',false], ['#hidden','hidden',true], ['#hidden','attached',true],
 ['#missing','hidden',true], ['#missing','detached',true], ['#missing','disabled',false],
 ['#check','checked',true], ['#check','unchecked',false], ['#disabled','disabled',true], ['#entry','enabled',true]
 ]) assert((await wait(selector,state)).value?.matched === expected, `${selector} ${state}`);
 document.querySelector('#hidden').style.display = 'block';
 assert((await wait('#hidden')).value?.matched === true, 'fresh probe sees visibility transition');
 // Fill uses independent page observers to check native values and events.
 const form = document.createElement('section');
 form.innerHTML = '<input id="fill-entry" data-testid="fill-entry" class="fill-many" value="old"><input class="fill-many" value="untouched"><textarea id="fill-notes"></textarea><div id="fill-edit" contenteditable="true">old editor</div>';
 document.body.append(form);
 const entry = document.getElementById('fill-entry'), events = [];
 const nativeValue = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
 let instanceAssignments = 0;
 Object.defineProperty(entry, 'value', {get(){return nativeValue.get.call(this)}, set(value){instanceAssignments++; nativeValue.set.call(this,value)}});
 for (const kind of ['beforeinput','input','change']) entry.addEventListener(kind, event => events.push({kind:event.type,value:entry.value,data:event.data,inputType:event.inputType,cancelable:event.cancelable,trusted:event.isTrusted}));
 const filled = await call({action:'fill',selector:'.fill-many',text:' replacement ',snapshot_after:true});
 assert(filled.value?.filled === true && entry.value === ' replacement ' && document.querySelectorAll('.fill-many')[1].value === 'untouched', 'fill mutates first CSS match only');
 assert(instanceAssignments === 0 && events.map(event=>event.kind).join(',') === 'beforeinput,input,change', 'native setter and one input/change sequence');
 assert(events[0].value === 'old' && events[0].data === ' replacement ' && events[0].inputType === 'insertReplacementText' && events[0].cancelable && events.every(event=>!event.trusted), 'cancelable replacement precedes mutation and events are synthetic');
 assert(filled.snapshot?.nodes?.length > 0 && events[1].value === ' replacement ', 'snapshot-after observes one completed mutation');
 assert((await find({kind:'testid',query:'fill-entry',exact:true})).value.ref === filled.value.ref, 'fill returns reusable document ref');
 await call({action:'fill',selector:filled.value.ref,text:''});
 assert(entry.value === '' && events.length === 6, 'empty fill clears with exactly one event sequence');
 entry.addEventListener('beforeinput',event=>event.preventDefault(),{once:true});
 code(await call({action:'fill',selector:'#fill-entry',text:'denied'}), 'input_rejected');
 assert(entry.value === '' && events.length === 7, 'cancelled beforeinput leaves native value and input/change untouched');
 const multiline = '  résumé\n雪 🪟 " \\ ';
 await call({action:'fill',selector:'#fill-notes',text:multiline});
 assert(document.querySelector('#fill-notes').value === multiline, 'textarea preserves Unicode multiline and whitespace');
 await call({action:'fill',selector:'#fill-edit',text:'literal <b>text</b>'});
 assert(document.querySelector('#fill-edit').textContent === 'literal <b>text</b>' && document.querySelector('#fill-edit').children.length === 0, 'contenteditable replacement is text, not HTML');
 code(await call({action:'fill',selector:'#missing',text:'x'}), 'element_not_found');
 code(await call({action:'fill',selector:'[',text:'x'}), 'invalid_selector');
 entry.remove();
 code(await call({action:'fill',selector:filled.value.ref,text:'x'}), 'stale_reference');
 const clicks = document.createElement('section');
 clicks.innerHTML = '<button id="click-one" class="click-many">First</button><button class="click-many">Second</button><input id="activate" type="checkbox"><input id="cancel-click" type="checkbox"><button id="disabled-click" disabled>Disabled</button><svg width="30" height="30"><circle id="svg-click" cx="15" cy="15" r="10"></circle></svg><button id="offscreen-click" style="display:block;margin-top:2000px">Far below</button>';
 document.body.append(clicks);
 const clickTarget = document.getElementById('click-one'), sequence = [], other = [];
 const order = ['pointerover','mouseover','pointerenter','mouseenter','pointermove','mousemove','pointerdown','mousedown','focus','pointerup','mouseup','click'];
 for (const kind of order) clickTarget.addEventListener(kind,event=>sequence.push({kind:event.type,buttons:event.buttons,detail:event.detail,bubbles:event.bubbles,trusted:event.isTrusted}));
 clicks.querySelectorAll('.click-many')[1].addEventListener('click',()=>other.push('click'));
 const clickContext = () => ({readyState:document.readyState,visibility:document.visibilityState,hasFocus:document.hasFocus(),activeElement:document.activeElement?.id,scroll:[scrollX,scrollY]});
 const clickBefore = clickContext();
 const clicked = await call({action:'click',selector:'.click-many',snapshot_after:true});
 assert(clicked.value?.dispatched === true && other.length === 0 && sequence.map(event=>event.kind).join(',') === order.join(','), 'first-match click emits the observed pointer/mouse/focus sequence', () => ({returned:clicked,observedEvents:sequence,otherEvents:other,before:clickBefore,after:clickContext()}));
 assert(sequence.filter(event=>event.kind!=='focus').every(event=>!event.trusted), 'pointer/mouse activation is synthetic, not an OS gesture');
 assert(!sequence[2].bubbles && !sequence[3].bubbles && sequence[6].buttons === 1 && sequence[7].buttons === 1 && sequence[9].buttons === 0 && sequence[10].detail === 1, 'enter bubbling and button/detail state');
 assert(clicked.snapshot?.nodes?.length > 0 && sequence.filter(event=>event.kind==='click').length === 1 && document.activeElement === clickTarget, 'snapshot follows one activation and DOM focus');
 await call({action:'click',selector:clicked.value.ref});
 assert(sequence.filter(event=>event.kind==='click').length === 2, 'click ref reuses exact element');
 const checkbox = document.getElementById('activate'), activation = [];
 for (const kind of ['pointerdown','mousedown']) checkbox.addEventListener(kind,event=>event.preventDefault());
 for (const kind of ['click','input','change']) checkbox.addEventListener(kind,event=>activation.push(event.type));
 await call({action:'click',selector:'#activate'});
 assert(checkbox.checked && activation.join(',') === 'click,input,change', 'cancelled down events still reach one native checkbox default activation');
 const cancelledClick = document.getElementById('cancel-click'), cancellation = [];
 cancelledClick.addEventListener('click',event=>{cancellation.push('click');event.preventDefault()});
 for (const kind of ['input','change']) cancelledClick.addEventListener(kind,event=>cancellation.push(event.type));
 const cancelledResult = await call({action:'click',selector:'#cancel-click'});
 assert(cancelledResult.value?.dispatched === true && !cancelledClick.checked && cancellation.join(',') === 'click', 'click cancellation rolls back native default activation without replay');
 let disabledEvents = 0;
 document.getElementById('disabled-click').addEventListener('pointerover',()=>disabledEvents++);
 code(await call({action:'click',selector:'#disabled-click'}), 'element_disabled');
 assert(disabledEvents === 0, 'disabled click rejects before event dispatch');
 let svgClicks = 0;
 document.getElementById('svg-click').addEventListener('click',event=>{if(event.detail===1)svgClicks++});
 await call({action:'click',selector:'#svg-click'});
 assert(svgClicks === 1, 'non-HTMLElement uses one DOM click event fallback');
 let point;
 document.getElementById('offscreen-click').addEventListener('pointerdown',event=>point=[event.clientX,event.clientY]);
 await call({action:'click',selector:'#offscreen-click'});
 const box = document.getElementById('offscreen-click').getBoundingClientRect();
 assert(box.top >= 0 && box.bottom <= innerHeight && point?.[0] === Math.floor(box.left + box.width/2) && point?.[1] === Math.floor(box.top + box.height/2), 'nearest scroll precedes center-point events');
 code(await call({action:'click',selector:'#absent-click'}), 'element_not_found');
 code(await call({action:'click',selector:'['}), 'invalid_selector');
 clickTarget.remove();
 code(await call({action:'click',selector:clicked.value.ref}), 'stale_reference');
 const appended = await call({action:'type',selector:'#fill-notes',text:'added'});
 assert(appended.value?.dispatched && document.getElementById('fill-notes').value === multiline + 'added', 'type appends text through the production edit owner', () => ({returned:appended}));
 // The interaction family observes actual event delivery and native defaults.
 const interact = (operation,selector,after=false) => call({action:'interact',operation,selector,snapshot_after:after});
 const controls = document.createElement('section');
 controls.innerHTML = '<button id="double" class="double-many">Double</button><button id="double-other" class="double-many">Other</button><input id="double-box" type="checkbox"><button id="hover-disabled" disabled>Hover</button><input id="checked-one" type="checkbox" class="checked-many"><input id="checked-other" type="checkbox" class="checked-many"><input id="radio-one" type="radio" name="radios"><input id="radio-other" type="radio" name="radios" checked><input id="checked-disabled" type="checkbox" disabled><input id="checked-cancel" type="checkbox"><input id="unchecked-cancel" type="checkbox" checked><div id="no-focus">No focus</div><button id="focus-far" style="position:absolute;top:5000px">Focus</button><div id="center-scroll" style="position:absolute;left:2500px;top:7500px;width:80px;height:60px"></div><div style="position:absolute;left:5000px;top:10000px;width:1px;height:1px"></div>';
 document.body.append(controls);
 const double = document.getElementById('double'), doubleEvents = [];
 for (const kind of ['pointerover','mouseover','pointerenter','mouseenter','pointermove','mousemove','pointerdown','mousedown','pointerup','mouseup','click','dblclick']) double.addEventListener(kind,event=>doubleEvents.push({kind:event.type,detail:event.detail,trusted:event.isTrusted}));
 let otherDouble = 0;
 document.getElementById('double-other').addEventListener('click',()=>otherDouble++);
 const doubled = await interact('dblclick','.double-many',true);
 const doubleExpected = ['pointerover','mouseover','pointerenter','mouseenter','pointermove','mousemove','pointerdown','mousedown','pointerup','mouseup','click'];
 assert(doubled.value?.dispatched && doubleEvents.map(e=>e.kind).join(',') === [...doubleExpected,...doubleExpected,'dblclick'].join(',') && otherDouble === 0, 'double click makes two complete first-match click attempts then one dblclick');
 assert(doubleEvents.at(-1).detail === 2 && doubleEvents.every(e=>!e.trusted) && doubled.snapshot?.nodes?.length > 0, 'double click detail2 is synthetic and snapshot observes the same two activations');
 await interact('dblclick',doubled.value.ref);
 assert(doubleEvents.filter(e=>e.kind==='click').length === 4, 'double click reuses the exact ref without an extra activation');
 let doubleBoxClicks = 0;
 document.getElementById('double-box').addEventListener('click',()=>doubleBoxClicks++);
 await interact('dblclick','#double-box');
 assert(!document.getElementById('double-box').checked && doubleBoxClicks === 2, 'double checkbox activation toggles twice');
 code(await interact('dblclick','#hover-disabled'), 'element_disabled');
 const hover = document.getElementById('hover-disabled'), hovered = [];
 for (const kind of [...doubleExpected,'focus']) hover.addEventListener(kind,event=>hovered.push({kind:event.type,bubbles:event.bubbles,buttons:event.buttons,trusted:event.isTrusted}));
 document.getElementById('double').focus();
 const focusBeforeHover = document.activeElement;
 await interact('hover','#hover-disabled',true);
 assert(hovered.map(e=>e.kind).join(',') === 'pointerover,mouseover,pointerenter,mouseenter,pointermove,mousemove' && document.activeElement === focusBeforeHover, 'hover permits disabled target without focus/down/up/activation');
 assert(hovered.every(e=>e.buttons===0 && !e.trusted) && hovered.filter(e=>e.kind.endsWith('enter')).every(e=>!e.bubbles), 'hover keeps enter nonbubbling and unpressed synthetic pointer');
 const farFocus = document.getElementById('focus-far');
 let focusClicks = 0; farFocus.addEventListener('click',()=>focusClicks++);
 await interact('focus','#focus-far');
 assert(document.activeElement === farFocus && farFocus.getBoundingClientRect().top < innerHeight && focusClicks === 0, 'focus uses ordinary focus scrolling without activation');
 const focusDisabled = await interact('focus','#hover-disabled');
 assert(focusDisabled.value?.dispatched && document.activeElement === farFocus, 'disabled focus completes without promising a focusable target');
 await interact('focus','#no-focus');
 assert(document.activeElement === farFocus, 'nonfocusable focus completes without fabricated focus');
 const checkedOne = document.getElementById('checked-one'), checkedEvents = [];
 for (const kind of ['pointerdown','mousedown','focus','click','input','change']) checkedOne.addEventListener(kind,event=>checkedEvents.push(event.type));
 const checkedResult = await interact('check','.checked-many',true);
 assert(checkedOne.checked && !document.getElementById('checked-other').checked && checkedEvents.join(',') === 'focus,click,input,change', 'check uses one DOM activation on first CSS match with no pointer sequence');
 assert(checkedResult.snapshot?.nodes?.length > 0 && document.activeElement === checkedOne, 'check snapshot observes actual checked state and DOM focus');
 const beforeSame = checkedEvents.join(',');
 await interact('check',checkedResult.value.ref);
 assert(checkedEvents.join(',') === beforeSame && checkedOne.checked, 'already checked ref emits no activation/input/change');
 await interact('uncheck',checkedResult.value.ref);
 assert(!checkedOne.checked && checkedEvents.slice(-3).join(',') === 'click,input,change', 'uncheck checkbox uses one native activation');
 const beforeUnchecked = checkedEvents.join(',');
 await interact('uncheck','#checked-one');
 assert(checkedEvents.join(',') === beforeUnchecked, 'already unchecked emits no activation/input/change');
 const radio = document.getElementById('radio-one'), radioEvents = [];
 for (const kind of ['click','input','change']) radio.addEventListener(kind,event=>radioEvents.push(event.type));
 await interact('check','#radio-one');
 assert(radio.checked && !document.getElementById('radio-other').checked && radioEvents.join(',') === 'click,input,change', 'radio check activates once and native group deselection applies');
 let intercepted = 0;
 const nativeChecked = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'checked');
 Object.defineProperty(radio,'checked',{configurable:true,get(){return nativeChecked.get.call(this)},set(){intercepted++}});
 await interact('uncheck','#radio-one');
 assert(!nativeChecked.get.call(radio) && intercepted === 0 && radioEvents.join(',') === 'click,input,change,input,change', 'radio uncheck uses inherited native setter and input/change without another click');
 const radioSame = radioEvents.join(',');
 await interact('uncheck','#radio-one');
 assert(radioEvents.join(',') === radioSame, 'already unchecked radio stays event-free');
 for (const [operation,id] of [['check','checked-cancel'],['uncheck','unchecked-cancel']]) {
   const node = document.getElementById(id), cancellation = [];
   node.addEventListener('click',event=>{cancellation.push(event.type);event.preventDefault()});
   for (const kind of ['input','change']) node.addEventListener(kind,event=>cancellation.push(event.type));
   code(await interact(operation,'#'+id,true), 'not_changed');
   assert(node.checked === (operation==='uncheck') && cancellation.join(',') === 'click', 'canceled '+operation+' fails final state validation without replay or forced state');
 }
 code(await interact('check','#hover-disabled'), 'not_checkable');
 code(await interact('uncheck','#checked-disabled'), 'element_disabled');
 const center = document.getElementById('center-scroll'), centerFocus = document.activeElement;
 const centered = await interact('scroll_into_view','#center-scroll',true);
 const centeredBox = center.getBoundingClientRect();
 assert(Math.abs(centeredBox.left+centeredBox.width/2-document.documentElement.clientWidth/2) <= 1 && Math.abs(centeredBox.top+centeredBox.height/2-document.documentElement.clientHeight/2) <= 1, 'scroll into view centers both axes immediately: ' + JSON.stringify({box:centeredBox.toJSON(),viewport:[document.documentElement.clientWidth,document.documentElement.clientHeight],scroll:[scrollX,scrollY]}));
 assert(centered.value?.dispatched && centered.snapshot?.nodes?.length > 0 && document.activeElement === centerFocus, 'scroll snapshot retains actual document focus');
 for (const operation of ['dblclick','hover','focus','check','uncheck','scroll_into_view']) {
   code(await interact(operation,'#absent-interaction'), 'element_not_found');
   code(await interact(operation,'['), 'invalid_selector');
 }
 double.remove();
 for (const operation of ['dblclick','hover','focus','check','uncheck','scroll_into_view']) code(await interact(operation,doubled.value.ref), 'stale_reference');
 {
 // Appending, value selection and pixel scrolling have distinct DOM contracts.
 const editing = document.createElement('section');
 editing.innerHTML = '<input id="type-one" class="type-many" value="seed"><input class="type-many" value="other"><textarea id="type-notes">old</textarea><div id="type-edit" contenteditable="true"><b>seed</b></div><input id="type-disabled" disabled value="old"><input id="type-readonly" readonly value="old"><select id="select-value"><option value="a">A</option><option value="b">B</option></select><select id="select-disabled" disabled><option value="a">A</option><option value="b">B</option></select><div id="not-value">No value</div><div class="scroll-many" id="scroll-one" style="width:150px;height:100px;overflow:scroll"><div style="width:1000px;height:1500px">Scroll content</div></div><div class="scroll-many" id="scroll-other" style="width:150px;height:100px;overflow:scroll"><div style="width:1000px;height:1500px">Other</div></div>';
 document.body.append(editing);
 const typedInput = document.getElementById('type-one'), typedEvents = [], keyboardEvents = [];
 const nativeValue = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value');
 let valueIntercepted = 0;
