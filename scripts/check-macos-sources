#!/usr/bin/env python3
"""Type-check native app slices and the external Save panel driver before Rust builds."""
from pathlib import Path
import platform
import subprocess
import sys

if sys.platform != "darwin":
    raise SystemExit("Native source checks require macOS and its SDK")

root = Path(__file__).resolve().parent.parent
sdk = subprocess.check_output(
    ["xcrun", "--sdk", "macosx", "--show-sdk-path"], text=True
).strip()
sources = sorted((root / "apps/macos/Sources").glob("*.swift"))
if not sources:
    raise SystemExit("No native app sources found")
architectures = ["arm64", "x86_64"]
if platform.machine() == "x86_64":
    architectures.reverse()
for architecture in architectures:
    subprocess.run([
        "xcrun", "swiftc", "-typecheck", "-swift-version", "6",
        "-strict-concurrency=complete", "-warnings-as-errors",
        "-target", f"{architecture}-apple-macosx14.0", "-sdk", sdk,
        "-import-objc-header", str(root / "crates/native-bridge/include/zmux.h"),
        *map(str, sources),
    ], check=True)
    subprocess.run([
        "xcrun", "swiftc", "-typecheck", "-parse-as-library", "-swift-version", "6",
        "-strict-concurrency=complete", "-warnings-as-errors", "-O",
        "-target", f"{architecture}-apple-macosx14.0", "-sdk", sdk,
        str(root / "tools/native-fixtures/save-panel-driver.swift"),
        "-framework", "AppKit", "-framework", "ApplicationServices",
    ], check=True)
print("Both native Swift slices and the Save panel driver type-check; linking and runtime checks remain required.")
