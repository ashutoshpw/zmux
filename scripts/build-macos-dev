#!/usr/bin/env python3
"""Build the independently authored universal development bundle on macOS."""
from pathlib import Path
import argparse
import hashlib
import json
import os
import platform
import plistlib
import shutil
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument("--architecture", choices=["universal", "host"], default="universal")
parser.add_argument("--with-ghostty", action="store_true", help="Link the optional engine; runtime selection remains explicit")
parser.add_argument("--ghostty-artifact-root", type=Path, help="Explicit retained engine artifact root; never rebuilt or downloaded")
parser.add_argument("--with-zellij", action="store_true", help="Package the explicit retained dependency; does not select a terminal backend")
parser.add_argument("--zellij-package-root", type=Path, help="Explicit retained package artifact directory; never downloaded or rebuilt")
args = parser.parse_args()
if args.with_ghostty != (args.ghostty_artifact_root is not None):
    parser.error("--with-ghostty and --ghostty-artifact-root must be supplied together")
if args.with_zellij != (args.zellij_package_root is not None):
    parser.error("--with-zellij and --zellij-package-root must be supplied together")
zellij_acceptance = None
if args.with_zellij:
    sys.path.insert(0, str(root / "tools/local-zellij-feasibility"))
    from package_admission import Rejected, accept, native_target, pin, verify_payload
    try:
        zellij_target = native_target(args.architecture, platform.system(), platform.machine())
        zellij_acceptance = accept(args.zellij_package_root, zellij_target)
    except (Rejected, OSError, ValueError, KeyError, TypeError) as error:
        parser.error(str(error))
if platform.system() != "Darwin":
    raise SystemExit("Native development builds require macOS; use GitHub's macOS development build workflow.")
def run(argv, **kwargs):
    return subprocess.run(argv, cwd=root, check=True, **kwargs)
sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
architectures = ["arm64", "x86_64"] if args.architecture == "universal" else ["arm64" if platform.machine() == "arm64" else "x86_64"]
artifact_root = args.ghostty_artifact_root.resolve(strict=True) if args.with_ghostty else None
if artifact_root:
    for arch in architectures:
        target = "aarch64-apple-darwin" if arch == "arm64" else "x86_64-apple-darwin"
        run(["python3", "tools/terminal-engine-artifacts/accept-linkage.py", "--target", target, "--root", str(artifact_root)])
dist = root / "dist"
bundle = dist / "zmux.app"
if bundle.is_symlink():
    raise SystemExit("Refusing to replace a symlink at the generated bundle path")
if bundle.exists():
    shutil.rmtree(bundle)
macos = bundle / "Contents/MacOS"
frameworks = bundle / "Contents/Frameworks"
resources = bundle / "Contents/Resources"
for path in [macos, frameworks, resources]:
    path.mkdir(parents=True, exist_ok=True)
zellij = None
if zellij_acceptance:
    dependency = resources / "Dependencies/local-zellij"
    accept(args.zellij_package_root, zellij_target, dependency)
    # Admission owns a private staging root; packaged resources must be readable
    # after the development bundle is copied to another user's installation.
    dependency.chmod(0o755)
    for directory in dependency.rglob("*"):
        if directory.is_dir():
            directory.chmod(0o755)
    zellij = dependency / "bin/zellij"
    # The retained Mach-O already carries its linker signature. Never silently
    # change independently tested dependency bytes to make signing succeed.
    run(["codesign", "--verify", "--strict", "--verbose=2", str(zellij)])
targetdir = Path(json.loads(subprocess.check_output(["cargo", "metadata", "--no-deps", "--locked", "--format-version", "1"], cwd=root, text=True))["target_directory"])
env = dict(os.environ, MACOSX_DEPLOYMENT_TARGET="14.0")
if artifact_root:
    env["ZMUX_GHOSTTY_ARTIFACT_ROOT"] = str(artifact_root)
else:
    env.pop("ZMUX_GHOSTTY_ARTIFACT_ROOT", None)
libraries = []
cli_binaries = []
for arch in architectures:
    target = "aarch64-apple-darwin" if arch == "arm64" else "x86_64-apple-darwin"
    run(["rustup", "target", "add", target])
    features = ["--features", "zmux-native-bridge/ghostty"] if artifact_root else []
    run(["cargo", "build", "--locked", "--release", "--target", target, "-p", "zmux-native-bridge", "-p", "zmux", *features], env=env)
    libraries.append(targetdir / target / "release/libzmux_native_bridge.dylib")
    cli_binaries.append(targetdir / target / "release/zmux")
library = frameworks / "libzmux_native_bridge.dylib"
run(["lipo", "-create", *map(str, libraries), "-output", str(library)])
run(["install_name_tool", "-id", "@rpath/libzmux_native_bridge.dylib", str(library)])
sdk = subprocess.check_output(["xcrun", "--sdk", "macosx", "--show-sdk-path"], text=True).strip()
sources = sorted((root / "apps/macos/Sources").glob("*.swift"))
binaries = []
for arch in architectures:
    binary = dist / f"zmux-app-{arch}"
    run(["xcrun", "swiftc", "-swift-version", "6", "-strict-concurrency=complete", "-warnings-as-errors", "-O", "-g",
         "-target", f"{arch}-apple-macosx14.0", "-sdk", sdk,
         "-import-objc-header", str(root / "crates/native-bridge/include/zmux.h"),
         *map(str, sources), "-L", str(frameworks), "-lzmux_native_bridge", "-framework", "AppKit", "-framework", "WebKit", "-framework", "UserNotifications", "-framework", "AuthenticationServices", "-framework", "Security", "-framework", "ImageIO", "-framework", "UniformTypeIdentifiers",
         "-Xlinker", "-rpath", "-Xlinker", "@executable_path/../Frameworks", "-o", str(binary)])
    binaries.append(binary)
executable = macos / "zmux-app"
run(["lipo", "-create", *map(str,binaries), "-output", str(executable)])
deployment = json.loads((root / "config/deployment.json").read_text())
from urllib.parse import urlsplit
origin = urlsplit(deployment["cloud_origin"])
if origin.scheme != "https" or not origin.hostname or origin.username or origin.password or origin.query or origin.fragment or origin.path not in ("", "/"):
    raise SystemExit("Deployment cloud_origin must be an HTTPS origin without credentials or path")
if deployment["native_client_id"] != "zmux-macos-dev" or deployment["native_callback"] != "zmux-dev://oauth/callback":
    raise SystemExit("Native client/callback must match the registered development channel")
cli = resources / "bin/zmux"
cli.parent.mkdir(parents=True, exist_ok=True)
run(["lipo", "-create", *map(str, cli_binaries), "-output", str(cli)])
iconset = dist / "AppIcon.iconset"
iconset.mkdir(parents=True, exist_ok=True)
for size in [16, 32, 128, 256, 512]:
    for scale in [1, 2]:
        suffix = "@2x" if scale == 2 else ""
        run(["sips", "-z", str(size * scale), str(size * scale), str(root / "apps/macos/Resources/AppIcon.png"),
             "--out", str(iconset / f"icon_{size}x{size}{suffix}.png")], stdout=subprocess.DEVNULL)
run(["iconutil", "-c", "icns", str(iconset), "-o", str(resources / "AppIcon.icns")])
shutil.copy2(root / "apps/macos/Resources/ICON-PROVENANCE.md", resources / "ICON-PROVENANCE.md")
info = {"CFBundleExecutable":"zmux-app", "CFBundleIdentifier":deployment["bundle_id"], "CFBundleName":"zmux",
        "CFBundleDisplayName":"zmux", "CFBundleIconFile":"AppIcon", "CFBundlePackageType":"APPL", "CFBundleShortVersionString":"0.2.0",
        "CFBundleVersion": os.environ.get("GITHUB_RUN_NUMBER", "1"), "LSMinimumSystemVersion":"14.0",
        "LSApplicationCategoryType":"public.app-category.developer-tools",
        "CFBundleURLTypes":[{"CFBundleURLName":"zmux cloud sign-in", "CFBundleURLSchemes":["zmux-dev"]}],
        "NSAppTransportSecurity":{"NSAllowsArbitraryLoadsInWebContent":True},
        "NSPrincipalClass":"ZmuxBrowserInputApplication", "NSHighResolutionCapable":True, "ZmuxSourceSHA":sha,
        "ZmuxCloudOrigin":deployment["cloud_origin"]}
with (bundle / "Contents/Info.plist").open("wb") as file:
    plistlib.dump(info,file)
for name in ["LICENSE", "THIRD_PARTY_NOTICES.md"]:
    shutil.copy2(root / name, resources / name)
metadata = {"source_sha":sha,"architectures":architectures,"minimum_macos":"14.0","bundle_id":info["CFBundleIdentifier"],"signing":"ad-hoc","notarized":False,"cloud_origin":deployment["cloud_origin"],"optional_ghostty_linked":bool(artifact_root),"default_terminal_engine":"vt100"}
metadata["optional_zellij_packaged"] = bool(zellij_acceptance)
if zellij_acceptance:
    metadata["optional_zellij"] = {**zellij_acceptance, "retained_artifact_expires_at": pin()["download"]["expires_at"],
                                  "native_start_attach_integrated": False, "default_acquisition_changed": False}
(resources / "build-info.json").write_text(json.dumps(metadata,indent=2)+"\n")
run(["codesign","--force","--sign","-",str(library)])
run(["codesign","--force","--sign","-",str(cli)])
run(["codesign","--force","--sign","-",str(bundle)])
run(["codesign","--verify","--deep","--strict","--verbose=2",str(bundle)])
if zellij:
    run(["codesign", "--verify", "--strict", "--verbose=2", str(zellij)])
    if verify_payload(zellij.parent.parent) != zellij_acceptance:
        raise SystemExit("Optional dependency changed while building/signing the application")
for path in [executable,library,cli]:
    actual = set(subprocess.check_output(["lipo","-archs",str(path)],text=True).split())
    if actual != set(architectures):
        raise SystemExit(f"Architecture mismatch for {path.name}: {actual}")
run(["otool","-L",str(executable)])
archive = dist / f"zmux-dev-{'universal' if len(architectures)==2 else architectures[0]}-{sha[:7]}.zip"
run(["ditto","-c","-k","--sequesterRsrc","--keepParent",str(bundle),str(archive)])
(archive.with_suffix(".zip.sha256")).write_text(hashlib.sha256(archive.read_bytes()).hexdigest()+"  "+archive.name+"\n")
(dist / "build-info.json").write_text(json.dumps(metadata,indent=2)+"\n")
print(f"Built development bundle and archive: {archive.name}")
