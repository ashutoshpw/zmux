#!/usr/bin/env python3
"""Launch the actual packaged application through Launch Services and inspect native evidence."""
from pathlib import Path
import json
import argparse
import os
import platform
import plistlib
import stat
import subprocess
import contextlib
import http.server
import threading
import shutil
import tempfile
import time
from importlib.util import module_from_spec, spec_from_file_location

fixture_spec = spec_from_file_location("native_ssh_fixture", Path(__file__).with_name("native-ssh-fixture.py"))
fixture_module = module_from_spec(fixture_spec)
fixture_spec.loader.exec_module(fixture_module)
cloud_fixture_spec = spec_from_file_location(
    "native_cloud_client_http_fixture",
    Path(__file__).resolve().parents[1] / "tools/native-fixtures/cloud-client-http.py",
)
cloud_fixture_module = module_from_spec(cloud_fixture_spec)
cloud_fixture_spec.loader.exec_module(cloud_fixture_module)
resource_spec = spec_from_file_location("native_resource_sampler", Path(__file__).with_name("native-resource-sampler.py"))
resource_module = module_from_spec(resource_spec)
resource_spec.loader.exec_module(resource_module)

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-accessibility-save-tests", action="store_true",
                    help="Explicitly defer real Save acceptance; retain native Cancel/cleanup and other checks")
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
if platform.system() != "Darwin":
    raise SystemExit("Packaged native app validation requires macOS")
dist = root / "dist"
bundle = dist / "zmux.app/Contents"
info = plistlib.loads((bundle / "Info.plist").read_bytes())
assert info["CFBundleName"] == "zmux"
assert (bundle / "Resources/AppIcon.icns").stat().st_size > 1024
for executable in [bundle / "Resources/bin/zmux", bundle / "MacOS/zmux-app"]:
    help_text = subprocess.run([str(executable), "--help"], check=True, capture_output=True, text=True, timeout=15).stdout
    for command in ["list-workspaces", "split-pane", "send-text", "read-screen"]:
        assert command in help_text, (executable, command)
# Run the independent fresh-profile window journey before save-panel driver
# setup and the broad smoke. A failed/timed-out journey stops here, so native
# fixture apps never overlap and browser/AX failures cannot erase this evidence.
subprocess.run([str(root / "scripts/check-native-windows")], check=True)
# User-deferred host permission gate is explicit; no automatic skip on failure.
if not args.skip_accessibility_save_tests:
    subprocess.run(["xcrun", "swiftc", "-parse-as-library", "-swift-version", "6",
                    "-strict-concurrency=complete", "-warnings-as-errors", "-O",
                    str(root / "tools/native-fixtures/save-panel-driver.swift"),
                    "-framework", "AppKit", "-framework", "ApplicationServices",
                    "-o", str(dist / "native-save-panel-driver")], check=True, timeout=60)

subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-Wall", "-Wextra", "-Werror",
                str(root / "tools/native-fixtures/profile-lease-probe.c"),
                "-o", str(dist / "native-profile-lease-probe")], check=True, timeout=30)

report = dist / "native-smoke.json"
for stale in (report, dist / "native-smoke.json.stages.json", dist / "native-download-preflight.log"):
    if stale.exists(): stale.unlink()
stdout = dist / "native-stdout.log"
stderr = dist / "native-stderr.log"
def diagnose_failure():
    # A missing report can follow a real smoke failure while its app still owns
    # sessions or a socket. Never start another app as a diagnostic retry.
    diagnostic = dist / "native-failure-process.json"
    observation = {"scope": "read_only_after_failed_smoke", "second_app_launched": False}
    resources = dist / "native-resources.json"
    try:
        if resources.exists():
            if resources.stat().st_size > 16 * 1024 * 1024:
                raise ValueError("Resource diagnostic exceeds 16 MiB")
            resources_data = json.loads(resources.read_text())
            if not isinstance(resources_data, dict) or not isinstance(resources_data.get("samples", []), list):
                raise ValueError("Resource diagnostic has an invalid sample shape")
            samples = resources_data.get("samples", [])
            observed = next((sample for sample in reversed(samples) if isinstance(sample, dict)
                             and type(sample.get("app_pid")) is int and 0 < sample["app_pid"] < 2**31), None)
            if observed:
                pid = observed["app_pid"]
                observation["last_sample"] = {key: observed.get(key) for key in
                                              ("app_pid", "sample_wall_unix_seconds", "elapsed_seconds")}
                # Read-only observation, never authority to signal a reused PID.
                try:
                    result = subprocess.run(["/bin/ps", "-p", str(pid), "-o", "pid=,ppid=,stat=,lstart=,comm="],
                                            capture_output=True, text=True, timeout=2)
                    observation["process_probe"] = {"return_code": result.returncode,
                                                    "stdout": result.stdout[:8192], "stderr": result.stderr[:2048]}
                except subprocess.TimeoutExpired:
                    observation["process_probe"] = {"timed_out": True}
    except (OSError, ValueError) as error:
        observation["diagnostics_error"] = str(error)[:2048]
    try:
        diagnostic.write_text(json.dumps(observation, indent=2) + "\n")
    except OSError as error:
        print("Failure diagnostic could not be retained: " + str(error)[:2048])
    print("Preserving original smoke failure; no diagnostic app relaunch. See " + str(diagnostic))
    for directory in [Path.home() / "Library/Logs/DiagnosticReports", Path("/Library/Logs/DiagnosticReports")]:
        if directory.exists():
            for path in sorted(directory.glob("zmux-app*"))[-4:]:
                target = dist / ("native-crash-" + path.name + ".log")
                try:
                    target.write_text(path.read_text(errors="replace"))
                    print(target.read_text()[:24_000])
                except OSError as error:
                    print("Crash diagnostic could not be retained: " + str(error)[:2048])
@contextlib.contextmanager
def local_tmux_fixture():
    binary = shutil.which("tmux")
    if binary is None:
        raise SystemExit("Packaged local tmux acceptance requires an installed tmux executable")
    # Keep HOME and the user's actual installation untouched. This is the same
    # explicit profile configuration supported by production CLI/native hosts.
    with tempfile.TemporaryDirectory(prefix="zmt-native-", dir="/tmp") as directory:
        profile = Path(directory).resolve() / "profile"
        native_environment = dict(os.environ, ZMUX_LOCAL_TMUX_ROOT=str(profile), ZMUX_LOCAL_TMUX_BIN=binary)
        try:
            listing = json.loads(subprocess.check_output([str(bundle / "Resources/bin/zmux"), "local-tmux", "list"],
                                                         env=native_environment, text=True, timeout=10))
            if listing["socket_path"] != str(profile / "server.sock") or listing["server_running"] or listing["sessions"]:
                raise RuntimeError("Refusing to launch native smoke against an unexpected/nonempty tmux profile")
            yield native_environment
        finally:
            socket = profile / "server.sock"
            if socket.exists():
                result = subprocess.run([binary, "-N", "-f", "/dev/null", "-S", str(socket), "kill-server"],
                                        capture_output=True, text=True, timeout=10)
                if result.returncode and "no server running" not in result.stderr and "No such file" not in result.stderr:
                    raise RuntimeError("Owned native tmux fixture cleanup failed: " + result.stderr)

@contextlib.contextmanager
def scheduler_fixture():
    helper = bundle / "Resources/remote-scheduler/darwin-universal/zmux-scheduler"
    tmux_binary = shutil.which("tmux")
    if not helper.is_file() or not os.access(helper, os.X_OK):
        raise SystemExit("Packaged Darwin scheduler helper is required for native schedule acceptance")
    if tmux_binary is None:
        raise SystemExit("Packaged scheduler acceptance requires an installed tmux executable")
    with tempfile.TemporaryDirectory(prefix="zsc-", dir="/tmp") as directory:
        root = Path(directory).resolve()
        state = root / "scheduler-state"
        state.mkdir(mode=0o700)
        state_metadata = state.lstat()
        if not stat.S_ISDIR(state_metadata.st_mode) or state_metadata.st_uid != os.getuid() \
                or stat.S_IMODE(state_metadata.st_mode) & 0o077:
            raise RuntimeError("Private scheduler fixture directory must be owned by this user with no group/world access")
        socket_path = root / "tmux.sock"
        app_control_socket = state / "app-control.sock"
        for path in (state / "control.sock", app_control_socket, socket_path):
            if len(os.fsencode(path)) >= 104:
                raise RuntimeError("Private scheduler fixture socket path exceeds the Darwin Unix-domain limit")
        tmux_binary = str(Path(tmux_binary).resolve())
        search_path = os.pathsep.join([str(Path(tmux_binary).parent), "/usr/bin", "/bin", "/usr/sbin", "/sbin"])
        environment = dict(os.environ)
        environment.pop("INVOCATION_ID", None)
        environment.update({
            "PATH": search_path,
            "ZMUX_SCHEDULER_ROOT": str(state),
            "ZMUX_SCHEDULER_TMUX_SOCKET": str(socket_path),
        })
        daemon_log = root / "scheduler-daemon.log"
        daemon = None
        try:
            subprocess.run([tmux_binary, "-f", "/dev/null", "-S", str(socket_path), "new-session", "-d",
                            "-s", "zmux-schedule-native", "/bin/sleep 3600"],
                           check=True, timeout=10, capture_output=True, text=True)
            with daemon_log.open("wb") as output:
                daemon = subprocess.Popen([str(helper), "serve"], env=environment,
                                          stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT)
            status_request = json.dumps({"protocol_version": 1, "action": {"action": "status"}}) + "\n"
            deadline = time.monotonic() + 8
            while True:
                if daemon.poll() is not None:
                    raise RuntimeError("Isolated scheduler daemon exited: " + daemon_log.read_text(errors="replace")[-8192:])
                try:
                    result = subprocess.run([str(helper), "rpc"], env=environment, input=status_request,
                                            capture_output=True, text=True, timeout=1)
                    if result.returncode == 0:
                        response = json.loads(result.stdout)
                        if response.get("result", {}).get("status") == "success":
                            break
                except (subprocess.TimeoutExpired, json.JSONDecodeError):
                    pass
                if time.monotonic() >= deadline:
                    raise RuntimeError("Isolated scheduler daemon did not accept its private readiness request")
                time.sleep(0.05)
            yield {
                "helper": str(helper),
                "root": str(state),
                "app_control_socket": str(app_control_socket),
                "socket": str(socket_path),
                "session_environment": {
                    "PATH": search_path,
                    "ZMUX_SCHEDULER_ROOT": str(state),
                    "ZMUX_SCHEDULER_TMUX_SOCKET": str(socket_path),
                },
            }
        finally:
            if daemon is not None:
                daemon.terminate()
                try:
                    daemon.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    daemon.kill()
                    daemon.wait(timeout=5)
            result = subprocess.run([tmux_binary, "-N", "-f", "/dev/null", "-S", str(socket_path), "kill-server"],
                                    capture_output=True, text=True, timeout=10)
            if result.returncode and "no server running" not in result.stderr.lower() and "no server running" not in result.stdout.lower():
                raise RuntimeError("Owned isolated scheduler tmux cleanup failed: " + result.stderr)

@contextlib.contextmanager
def browser_fixture():
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.startswith("/download"):
                if self.path == "/download-redirect":
                    self.send_response(302)
                    self.send_header("Location", "/download-cookie")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                if self.path == "/download-cookie" and "zmuxDownload=allowed" not in self.headers.get("Cookie", ""):
                    self.send_response(403)
                    self.send_header("Content-Type", "text/html")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                body = b"zmux-native-download\x00\xff\x01"
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                if self.path != "/download-mime":
                    self.send_header("Content-Disposition", 'attachment; filename="fixture.bin"')
                slow = self.path == "/download-slow"
                broken = self.path == "/download-fail"
                self.send_header("Content-Length", str(100000 if broken else len(body) * (100 if slow else 1)))
                self.end_headers()
                try:
                    for _ in range(100 if slow else 1):
                        self.wfile.write(body)
                        self.wfile.flush()
                        if slow: time.sleep(0.05)
                except (BrokenPipeError, ConnectionResetError):
                    # An actual native cancellation is expected to close the peer.
                    pass
                if broken: self.close_connection = True
                return
            second = self.path == "/second"
            title = "CSP fixture" if self.path == "/csp" else ("Second fixture" if second else "First fixture")
            body = (f"<!doctype html><title>{title}</title><main><h1>{title}</h1>"
                    "<label for='entry'>Entry</label><input id='entry' value='initial'>"
                    "<input id='checked' type='checkbox' checked><button id='button'>Continue</button>"
                    "<a href='/second'>Next page</a></main>").encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            if self.path == "/csp":
                self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'self'")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        def log_message(self, *_):
            pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    worker = threading.Thread(target=server.serve_forever, daemon=True)
    worker.start()
    (dist / "native-browser-fixture.json").write_text(json.dumps({"origin": f"http://127.0.0.1:{server.server_port}"}))
    try:
        yield
    finally:
        server.shutdown()
        server.server_close()
        worker.join(timeout=2)

@contextlib.contextmanager
def cloud_terminal_fixture():
    state = cloud_fixture_module.FixtureState()
    state.cloud_terminal_presence_attempts = []

    class LifecycleHandler(cloud_fixture_module.Handler):
        def read_body(self):
            body = super().read_body()
            if self.path.startswith("/v1/devices/") and self.path.endswith("/presence"):
                self.cloud_terminal_presence_sharing = bool(body.get("sharing")) if body else False
            return body

        def reply(self, status, value):
            if (self.path.startswith("/v1/devices/") and self.path.endswith("/presence")
                    and hasattr(self, "cloud_terminal_presence_sharing")):
                with self.server.state.lock:
                    self.server.state.cloud_terminal_presence_attempts.append(
                        {"sharing": self.cloud_terminal_presence_sharing, "status": status})
            super().reply(status, value)

        def do_GET(self):
            if self.path == "/__fixture/held":
                with self.server.state.lock:
                    gate = self.server.state.gates.get("cloud-terminal-lifecycle")
                    is_held = bool(gate and gate["entered"].is_set())
                self.reply(200, {"held": is_held})
                return
            if self.path == "/__fixture/state":
                with self.server.state.lock:
                    attempts = list(self.server.state.cloud_terminal_presence_attempts)
                    updates = [attempt["sharing"] for attempt in attempts]
                self.reply(200, {"presence_updates": updates, "presence_attempts": attempts})
                return
            super().do_GET()

        def do_POST(self):
            if self.path == "/__fixture/arm":
                body = self.read_body()
                point = body.get("point") if body else None
                if point not in {"devices", "presence"}:
                    self.reply(400, {"error": "invalid fixture hold point"})
                    return
                gate = {"entered": threading.Event(), "release": threading.Event(), "status": 200}
                with self.server.state.lock:
                    old = self.server.state.gates.get("cloud-terminal-lifecycle")
                    if old:
                        old["release"].set()
                    self.server.state.gates["cloud-terminal-lifecycle"] = gate
                    self.server.state.pending[(point, "relay-host")] = gate
                self.reply(200, {"armed": True})
                return
            if self.path == "/__fixture/release":
                with self.server.state.lock:
                    gate = self.server.state.gates.get("cloud-terminal-lifecycle")
                    if gate:
                        gate["release"].set()
                self.reply(200, {"released": True})
                return
            if self.path == "/__fixture/reset":
                with self.server.state.lock:
                    self.server.state.presence_updates.clear()
                    self.server.state.cloud_terminal_presence_attempts.clear()
                self.reply(200, {"reset": True})
                return
            if self.path in {"/__fixture/fail-next-presence-clear", "/__fixture/fail-next-presence"}:
                body = self.read_body()
                sharing = body.get("sharing", False) if body else False
                status = body.get("status", 503) if body else 503
                if type(sharing) is not bool or type(status) is not int or status not in {401, 409, 503}:
                    self.reply(400, {"error": "invalid presence failure fixture"})
                    return
                gate = {"entered": threading.Event(), "release": threading.Event(), "status": status}
                gate["release"].set()
                with self.server.state.lock:
                    key = ("presence", "relay-host")
                    if key in self.server.state.pending:
                        self.reply(409, {"error": "a presence gate is already armed"})
                        return
                    self.server.state.pending[key] = gate
                self.reply(200, {"armed": True})
                return
            super().do_POST()

    class CloudTerminalServer(cloud_fixture_module.FixtureServer):
        def __init__(self, fixture_state):
            http.server.ThreadingHTTPServer.__init__(self, ("127.0.0.1", 0), LifecycleHandler)
            self.state = fixture_state

    servers = [CloudTerminalServer(state) for _ in range(2)]
    workers = [threading.Thread(target=server.serve_forever, daemon=True) for server in servers]
    for worker in workers:
        worker.start()
    origins = [f"http://127.0.0.1:{server.server_port}" for server in servers]
    (dist / "native-cloud-terminal-fixture.json").write_text(
        json.dumps({"host_origin": origins[0], "viewer_origin": origins[1]}))
    try:
        yield {"host": origins[0], "viewer": origins[1]}
    finally:
        with state.lock:
            for gate in state.gates.values():
                gate["release"].set()
        for server in servers:
            server.shutdown()
            server.server_close()
        for worker in workers:
            worker.join(timeout=2)

with local_tmux_fixture() as native_environment, scheduler_fixture() as scheduler_environment, browser_fixture(), cloud_terminal_fixture() as cloud_origins, fixture_module.native_ssh_fixture(
        dist / "native-ssh-fixture.json", dist / "native-sshd.log",
        session_environment=scheduler_environment["session_environment"], scheduler_rpc_request_log=True,
        drop_scheduler_rpc_response_after_execution=True):
    lifecycle_report = dist / "native-cloud-terminal-lifecycle.json"
    lifecycle_stdout = dist / "native-cloud-terminal-lifecycle.stdout.log"
    lifecycle_stderr = dist / "native-cloud-terminal-lifecycle.stderr.log"
    if lifecycle_report.exists(): lifecycle_report.unlink()
    try:
        subprocess.run(["/usr/bin/open", "-n", "-W", "--stdout", str(lifecycle_stdout), "--stderr", str(lifecycle_stderr),
                        str(dist / "zmux.app"), "--args", "--cloud-terminal-lifecycle-smoke",
                        str(lifecycle_report), cloud_origins["host"], cloud_origins["viewer"]], check=True, timeout=120)
    except Exception as error:
        for path in [lifecycle_stdout, lifecycle_stderr]:
            if path.exists(): print(path.read_text())
        if isinstance(error, subprocess.TimeoutExpired):
            print("Cloud terminal lifecycle smoke timed out; its app may remain alive.")
        diagnose_failure()
        raise
    if not lifecycle_report.exists():
        for path in [lifecycle_stdout, lifecycle_stderr]:
            if path.exists(): print(path.read_text())
        diagnose_failure()
        raise SystemExit("The packaged app did not produce Cloud terminal lifecycle evidence")
    lifecycle_evidence = json.loads(lifecycle_report.read_text())
    if lifecycle_evidence.get("scope") != "cloud_terminal_lifecycle_two_peer_access_and_account_switch" or lifecycle_evidence.get("state") != "passed":
        raise SystemExit("Cloud terminal lifecycle and two-peer evidence has an invalid scope or state")
    scenarios = lifecycle_evidence.get("scenarios", [])
    expected_scenarios = {"toggle_off_during_local_device_lookup", "credential_stop_during_presence_publish"}
    expected_presence = {
        "toggle_off_during_local_device_lookup": [],
        "credential_stop_during_presence_publish": [True, False],
        "namespace_change_retries_failed_presence_clear": [True, False, False],
    }
    expected_attempts = {
        "toggle_off_during_local_device_lookup": [],
        "credential_stop_during_presence_publish": [
            {"sharing": True, "status": 200}, {"sharing": False, "status": 200}],
        "namespace_change_retries_failed_presence_clear": [
            {"sharing": True, "status": 200},
            {"sharing": False, "status": 503},
            {"sharing": False, "status": 200}],
    }
    expected_scenarios.add("namespace_change_retries_failed_presence_clear")
    if len(scenarios) != 3 or {item.get("name") for item in scenarios} != expected_scenarios or any(
            item.get("host_state") != "off"
            or item.get("presence_updates") != expected_presence.get(item.get("name"))
            or item.get("presence_attempts") != expected_attempts.get(item.get("name"))
            or item.get("local_gate_confirmed_disabled") is not True
            or item.get("post_stop_gate_error_code") != "sharing_disabled" for item in scenarios):
        raise SystemExit("Cloud terminal lifecycle stop race did not match its observed presence sequence")
    relay = lifecycle_evidence.get("relay")
    if not isinstance(relay, dict) or relay.get("same_device_after_repeated_registration") is not True \
            or type(relay.get("listed_sessions")) is not int or relay["listed_sessions"] < 1 \
            or relay.get("read_existing_frame") is not True \
            or relay.get("input_marker_observed") is not True \
            or relay.get("resize_rows") != 18 or relay.get("resize_cols") != 72 \
            or relay.get("viewport_rows") != 18 or relay.get("viewport_cols") != 72 \
            or relay.get("kernel_size_output") != "18 72" \
            or relay.get("presence_cleared") is not True \
            or relay.get("post_stop_gate_error_code") != "sharing_disabled":
        raise SystemExit("Cloud terminal two-peer relay evidence did not prove list/frame/input/resize and Rust gate revocation")

    rejected_start = lifecycle_evidence.get("rejected_start")
    if not isinstance(rejected_start, dict) \
            or rejected_start.get("presence_updates") != [True, True, False] \
            or rejected_start.get("presence_attempts") != [
                {"sharing": True, "status": 409},
                {"sharing": True, "status": 200},
                {"sharing": False, "status": 200}] \
            or rejected_start.get("owner_off_after_rejection") is not True \
            or rejected_start.get("local_gate_closed_after_rejection") is not True \
            or rejected_start.get("retry_enabled") is not True \
            or rejected_start.get("retry_stopped") is not True \
            or rejected_start.get("post_stop_gate_error_code") != "sharing_disabled":
        raise SystemExit("A rejected sharing=true request did not leave the gate closed for a clean retry")

    account_switch = lifecycle_evidence.get("account_switch")
    if not isinstance(account_switch, dict) \
            or account_switch.get("presence_updates") != [True, False, True, False] \
            or account_switch.get("presence_attempts") != [
                {"sharing": True, "status": 200},
                {"sharing": False, "status": 401},
                {"sharing": True, "status": 200},
                {"sharing": False, "status": 200}] \
            or account_switch.get("old_stop_warning_returned") is not True \
            or account_switch.get("old_presence_clear_confirmed") is not False \
            or account_switch.get("old_device_still_sharing_after_expired_session") is not True \
            or account_switch.get("old_device_still_sharing_after_account_switch") is not True \
            or account_switch.get("local_gate_closed_after401") is not True \
            or account_switch.get("old_cleanup_context_retired_with_unresolved_warning") is not True \
            or account_switch.get("same_installation_after_account_switch") is not True \
            or account_switch.get("new_account_device_is_different") is not True \
            or account_switch.get("first_new_account_enable_required_separate_action") is not True \
            or account_switch.get("local_gate_closed_after_rejected_enable") is not True \
            or account_switch.get("new_account_enabled") is not True \
            or account_switch.get("new_account_stop_confirmed") is not True \
            or account_switch.get("post_old_stop_gate_error_code") != "sharing_disabled" \
            or account_switch.get("post_new_stop_gate_error_code") != "sharing_disabled":
        raise SystemExit("The expired-session account switch did not retain old presence truth and require a separate new-account enable")

    schedule_report = dist / "native-schedule-messages-smoke.json"
    schedule_stdout = dist / "native-schedule-messages-smoke.stdout.log"
    schedule_stderr = dist / "native-schedule-messages-smoke.stderr.log"
    schedule_screenshot = dist / "zmux-scheduled-messages.png"
    for stale in (schedule_report, schedule_stdout, schedule_stderr, schedule_screenshot):
        if stale.exists(): stale.unlink()
    schedule_control = Path(scheduler_environment["app_control_socket"])
    try:
        subprocess.run([
            "/usr/bin/open", "-n", "-W", "--stdout", str(schedule_stdout), "--stderr", str(schedule_stderr),
            "--env", "ZMUX_SOCKET_PATH=" + str(schedule_control),
            "--env", "ZMUX_SCHEDULER_REMOTE_HELPER=" + scheduler_environment["helper"],
            "--env", "ZMUX_LOCAL_TMUX_ROOT=" + native_environment["ZMUX_LOCAL_TMUX_ROOT"],
            "--env", "ZMUX_LOCAL_TMUX_BIN=" + native_environment["ZMUX_LOCAL_TMUX_BIN"],
            str(dist / "zmux.app"), "--args", "--schedule-messages-smoke", str(schedule_report),
            str(dist / "native-ssh-fixture.json")
        ], check=True, timeout=180)
    except Exception:
        for path in (schedule_stdout, schedule_stderr):
            if path.exists(): print(path.read_text(errors="replace"))
        if schedule_report.is_file():
            try:
                failed_schedule = json.loads(schedule_report.read_text())
            except (OSError, ValueError):
                failed_schedule = None
            if isinstance(failed_schedule, dict) and failed_schedule.get("scope") == "native_schedule_messages" \
                    and failed_schedule.get("state") == "failed":
                failure = failed_schedule.get("failure")
                detail = failure[:2048] if isinstance(failure, str) and failure else "report state is failed"
                print("Scheduled-message smoke report failure: " + detail)
        diagnose_failure()
        raise
    if not schedule_report.exists():
        for path in (schedule_stdout, schedule_stderr):
            if path.exists(): print(path.read_text(errors="replace"))
        diagnose_failure()
        raise SystemExit("The packaged app did not produce scheduled-message smoke evidence")
    schedule_evidence = json.loads(schedule_report.read_text())
    if schedule_evidence.get("scope") != "native_schedule_messages" or schedule_evidence.get("state") != "passed":
        failure = schedule_evidence.get("failure")
        if schedule_evidence.get("scope") == "native_schedule_messages" \
                and schedule_evidence.get("state") == "failed" and isinstance(failure, str) and failure:
            raise SystemExit("Packaged scheduled-message smoke failed: " + failure[:2048])
        raise SystemExit("Packaged scheduled-message smoke evidence has an invalid scope or state")
    required_schedule_checks = {
        "workspace_menu_opens_embedded_scheduler_tab",
        "native_setup_popover_keeps_diagnostics_off_the_toolbar",
        "native_inspector_collapse_preserves_dirty_draft",
        "workspace_context_menu_uses_clicked_ssh_source_and_deduplicates_tab",
        "relative_create_edit_countdown_and_exact_message_only_deadline",
        "managed_ssh_refresh_shows_remote_tmux_target",
        "lost_create_reply_enters_unknown_outcome_ui",
        "applied_create_receipt_selects_one_populated_job_without_duplicate",
        "message_only_edit_preserves_deadline",
        "time_only_edit_preserves_message",
        "combined_message_and_time_edit",
        "cancel_removes_pending_job_and_history_view_retains_receipt",
        "populated_history_editor_screenshot_retained",
        "scheduled_messages_layout_geometry_and_visible_text",
        "captured_create_edit_cancel_ids_resolve_through_managed_status",
        "dirty_refresh_retains_original_version_and_rejects_concurrent_overwrite",
    }
    receipts = schedule_evidence.get("mutation_receipts", [])
    if schedule_evidence.get("source_sha") != info.get("ZmuxSourceSHA") \
            or not required_schedule_checks.issubset(schedule_evidence.get("checks", [])) \
            or [item.get("action") for item in receipts] != ["create", "edit", "edit", "edit", "cancel"] \
            or any(item.get("receipt_state") != "applied" for item in receipts) \
            or schedule_evidence.get("unknown_outcome_ui_exercised") is not True:
        raise SystemExit("Packaged scheduled-message evidence has an invalid scope, receipt set, or state")
    cas_refresh = schedule_evidence.get("cas_refresh_rejection")
    if not isinstance(cas_refresh, dict) \
            or type(cas_refresh.get("original_version")) is not int \
            or cas_refresh.get("original_version") != 1 \
            or type(cas_refresh.get("remote_version")) is not int \
            or cas_refresh.get("remote_version") != 2 \
            or type(cas_refresh.get("cleanup_version")) is not int \
            or cas_refresh.get("cleanup_version") != 3:
        raise SystemExit("Packaged scheduled-message evidence has invalid dirty-refresh CAS versions")
    retained_message = cas_refresh.get("retained_message")
    remote_message_after_rejection = cas_refresh.get("remote_message_after_rejection")
    if not isinstance(retained_message, str) or not retained_message.strip() \
            or not isinstance(remote_message_after_rejection, str) \
            or not remote_message_after_rejection.strip() \
            or retained_message == remote_message_after_rejection:
        raise SystemExit("Dirty-refresh CAS rejection did not retain distinct nonempty local and remote messages")
    if schedule_evidence.get("screenshot") != schedule_screenshot.name or not schedule_screenshot.is_file() \
            or schedule_screenshot.stat().st_size <= 4096:
        raise SystemExit("The populated scheduled-message history screenshot was not retained")

    sampler = resource_module.NativeResourceSampler(
        bundle / "MacOS/zmux-app", bundle / "Resources/bin/zmux",
        dist / "native-resources.json", info.get("ZmuxSourceSHA"),
    )
    try:
        try:
            sampler.start()
            subprocess.run(["/usr/bin/open","-n","-W","--stdout",str(stdout),"--stderr",str(stderr),
                            "--env", "ZMUX_LOCAL_TMUX_ROOT=" + native_environment["ZMUX_LOCAL_TMUX_ROOT"],
                            "--env", "ZMUX_LOCAL_TMUX_BIN=" + native_environment["ZMUX_LOCAL_TMUX_BIN"],
                            "--env", "ZMUX_NATIVE_SKIP_ACCESSIBILITY_SAVE_TESTS=" + ("1" if args.skip_accessibility_save_tests else "0"),
                            str(dist / "zmux.app"),"--args","--smoke-test",str(report)],check=True,timeout=180)
        finally:
            sampler.stop()
    except Exception as error:
        for path in [stdout,stderr]:
            if path.exists(): print(path.read_text())
        if isinstance(error, subprocess.TimeoutExpired):
            print("Launch Services smoke timed out; its app may remain alive.")
        diagnose_failure()
        raise
    if not report.exists():
        for path in [stdout,stderr]:
            if path.exists(): print(path.read_text())
        diagnose_failure()
        raise SystemExit("The packaged app did not produce native smoke evidence")
evidence = json.loads(report.read_text())
metadata = json.loads((dist / "build-info.json").read_text())
if evidence.get("source_sha") != metadata["source_sha"]: raise SystemExit("Smoke evidence does not match packaged source SHA")
for key in ["success","remote_file_url_symlink","remote_file_url_directory_refusal","ssh_reconnect_native_icon","workspace_metadata","workspace_pull_request_metadata","workspace_todo_metadata","native_input","terminal_special_keys","ansi_color","split_panes","kernel_resize","workspace_switch","workspace_order","surface_order","file_panel","workspace_number","pane_close","active_terminal_title","native_cloud_callback","clipboard_image_preparation","clipboard_image_pasteboard","clipboard_image_local_paste","clipboard_image_remote_transfer","clipboard_image_remote_shell_path","clipboard_image_remote_source_lifetime","clipboard_image_remote_source_cleanup","clipboard_image_remote_managed_connection","clipboard_image_remote_focus_retained","bundled_cli_control","accessible_icon_controls","terminal_tab_shortcut","close_tab_shortcut","reopen_tab_shortcut","sibling_process_preserved","sidebar_toggle","sidebar_resize","notification_inbox","notification_target_routing","embedded_webkit","browser_hidden_state","balanced_browser_split","split_ratio_retained","tab_navigation_shared_actions","ctrl_tab_navigation","ctrl_tab_single_tab_no_input","ctrl_tab_multipane_scoping","workspace_navigation_shortcuts","directional_pane_focus_shortcuts","directional_split_up","pane_reopen_original_split_anchor","global_focus_history_shortcuts","browser_directional_focus","browser_cli_automation","browser_page_zoom","browser_fill","browser_click","browser_interactions","browser_edit_scroll","browser_keyboard","browser_locators_waits","browser_profiles_isolation_reopen","browser_profile_menu","browser_profile_management","browser_downloads_cancel_native","local_tmux_cli_native_reopen","browser_never_selected_viewport","browser_csp_eval_once","browser_title_observation","notification_permission_ordering","notification_cli_metadata","notification_workspace_target","notification_jump_to_unread","notification_reply_pty"]:
    if evidence.get(key) is not True: raise SystemExit(f"Native check failed: {key}")
if evidence.get("workspace_order_drag") is not True: raise SystemExit("Native check failed: workspace_order_drag")
expected_save_state = "skipped_user_deferred" if args.skip_accessibility_save_tests else "passed"
if evidence.get("native_save_dialog_accessibility") != expected_save_state:
    raise SystemExit("Save-dialog evidence does not match the explicitly selected validation scope")
if evidence.get("browser_downloads_native") is not (not args.skip_accessibility_save_tests):
    raise SystemExit("Save-dependent download checks must not be reported passed when skipped")
print(json.dumps(evidence,indent=2))
