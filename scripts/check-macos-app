#!/usr/bin/env python3
"""Launch the actual packaged application through Launch Services and inspect native evidence."""
from pathlib import Path
import json
import platform
import plistlib
import subprocess
import contextlib
import http.server
import threading
from importlib.util import module_from_spec, spec_from_file_location

fixture_spec = spec_from_file_location("native_ssh_fixture", Path(__file__).with_name("native-ssh-fixture.py"))
fixture_module = module_from_spec(fixture_spec)
fixture_spec.loader.exec_module(fixture_module)

root = Path(__file__).resolve().parent.parent
if platform.system() != "Darwin":
    raise SystemExit("Packaged native app validation requires macOS")
dist = root / "dist"
bundle = dist / "zmux.app/Contents"
info = plistlib.loads((bundle / "Info.plist").read_bytes())
assert info["CFBundleName"] == "zmux"
assert (bundle / "Resources/AppIcon.icns").stat().st_size > 1024
for executable in [bundle / "Resources/bin/zmux", bundle / "MacOS/zmux-app"]:
    help_text = subprocess.run([str(executable), "--help"], check=True, capture_output=True, text=True, timeout=15).stdout
    for command in ["list-workspaces", "split-pane", "send-text", "read-screen"]:
        assert command in help_text, (executable, command)
report = dist / "native-smoke.json"
if report.exists(): report.unlink()
stdout = dist / "native-stdout.log"
stderr = dist / "native-stderr.log"
def diagnose_startup():
    # Launch Services can report success even when the child crashes before stderr
    # opens. Run the same packaged executable for diagnostics only; this cannot
    # substitute for a successful Launch Services smoke check.
    diagnostic = dist / "native-direct.log"
    with diagnostic.open("w") as log:
        try:
            result = subprocess.run([str(dist / "zmux.app/Contents/MacOS/zmux-app"),
                                     "--smoke-test", str(dist / "native-direct-smoke.json")],
                                    stdout=log, stderr=subprocess.STDOUT, timeout=100)
            log.write(f"\nPackaged executable return code: {result.returncode}\n")
        except subprocess.TimeoutExpired:
            log.write("\nPackaged executable diagnostic timed out\n")
    print(diagnostic.read_text())
    for directory in [Path.home() / "Library/Logs/DiagnosticReports", Path("/Library/Logs/DiagnosticReports")]:
        if directory.exists():
            for path in sorted(directory.glob("zmux-app*"))[-4:]:
                target = dist / ("native-crash-" + path.name + ".log")
                target.write_text(path.read_text(errors="replace"))
                print(target.read_text()[:24_000])
@contextlib.contextmanager
def browser_fixture():
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            second = self.path == "/second"
            title = "Second fixture" if second else "First fixture"
            body = (f"<!doctype html><title>{title}</title><main><h1>{title}</h1>"
                    "<label for='entry'>Entry</label><input id='entry' value='initial'>"
                    "<input id='checked' type='checkbox' checked><button id='button'>Continue</button>"
                    "<a href='/second'>Next page</a></main>").encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        def log_message(self, *_):
            pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    worker = threading.Thread(target=server.serve_forever, daemon=True)
    worker.start()
    (dist / "native-browser-fixture.json").write_text(json.dumps({"origin": f"http://127.0.0.1:{server.server_port}"}))
    try:
        yield
    finally:
        server.shutdown()
        server.server_close()
        worker.join(timeout=2)

with browser_fixture(), fixture_module.native_ssh_fixture(dist / "native-ssh-fixture.json", dist / "native-sshd.log"):
    try:
        subprocess.run(["/usr/bin/open","-n","-W","--stdout",str(stdout),"--stderr",str(stderr),str(dist / "zmux.app"),"--args","--smoke-test",str(report)],check=True,timeout=150)
    except Exception:
        for path in [stdout,stderr]:
            if path.exists(): print(path.read_text())
        diagnose_startup()
        raise
    if not report.exists():
        for path in [stdout,stderr]:
            if path.exists(): print(path.read_text())
        diagnose_startup()
        raise SystemExit("The packaged app did not produce native smoke evidence")
evidence = json.loads(report.read_text())
metadata = json.loads((dist / "build-info.json").read_text())
if evidence.get("source_sha") != metadata["source_sha"]: raise SystemExit("Smoke evidence does not match packaged source SHA")
for key in ["success","native_input","ansi_color","split_panes","kernel_resize","workspace_switch","pane_close","active_terminal_title","native_cloud_callback","clipboard_image_preparation","clipboard_image_pasteboard","clipboard_image_local_paste","clipboard_image_remote_transfer","clipboard_image_remote_shell_path","clipboard_image_remote_source_lifetime","clipboard_image_remote_source_cleanup","clipboard_image_remote_managed_connection","clipboard_image_remote_focus_retained","bundled_cli_control","accessible_icon_controls","terminal_tab_shortcut","close_tab_shortcut","reopen_tab_shortcut","sibling_process_preserved","sidebar_toggle","notification_inbox","notification_target_routing","embedded_webkit","browser_hidden_state","balanced_browser_split","split_ratio_retained","tab_navigation_shared_actions","workspace_navigation_shortcuts","directional_pane_focus_shortcuts","directional_split_up","pane_reopen_original_split_anchor","global_focus_history_shortcuts","browser_directional_focus","browser_cli_automation"]:
    if evidence.get(key) is not True: raise SystemExit(f"Native check failed: {key}")
print(json.dumps(evidence,indent=2))
