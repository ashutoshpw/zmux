#!/usr/bin/env python3
"""Launch the actual packaged application through Launch Services and inspect native evidence."""
from pathlib import Path
import json
import argparse
import os
import platform
import plistlib
import subprocess
import contextlib
import http.server
import threading
import shutil
import tempfile
import time
from importlib.util import module_from_spec, spec_from_file_location

fixture_spec = spec_from_file_location("native_ssh_fixture", Path(__file__).with_name("native-ssh-fixture.py"))
fixture_module = module_from_spec(fixture_spec)
fixture_spec.loader.exec_module(fixture_module)
resource_spec = spec_from_file_location("native_resource_sampler", Path(__file__).with_name("native-resource-sampler.py"))
resource_module = module_from_spec(resource_spec)
resource_spec.loader.exec_module(resource_module)

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-accessibility-save-tests", action="store_true",
                    help="Explicitly defer real Save acceptance; retain native Cancel/cleanup and other checks")
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
if platform.system() != "Darwin":
    raise SystemExit("Packaged native app validation requires macOS")
dist = root / "dist"
bundle = dist / "zmux.app/Contents"
info = plistlib.loads((bundle / "Info.plist").read_bytes())
assert info["CFBundleName"] == "zmux"
assert (bundle / "Resources/AppIcon.icns").stat().st_size > 1024
for executable in [bundle / "Resources/bin/zmux", bundle / "MacOS/zmux-app"]:
    help_text = subprocess.run([str(executable), "--help"], check=True, capture_output=True, text=True, timeout=15).stdout
    for command in ["list-workspaces", "split-pane", "send-text", "read-screen"]:
        assert command in help_text, (executable, command)
# Run the independent fresh-profile window journey before save-panel driver
# setup and the broad smoke. A failed/timed-out journey stops here, so native
# fixture apps never overlap and browser/AX failures cannot erase this evidence.
subprocess.run([str(root / "scripts/check-native-windows")], check=True)
# User-deferred host permission gate is explicit; no automatic skip on failure.
if not args.skip_accessibility_save_tests:
    subprocess.run(["xcrun", "swiftc", "-parse-as-library", "-swift-version", "6",
                    "-strict-concurrency=complete", "-warnings-as-errors", "-O",
                    str(root / "tools/native-fixtures/save-panel-driver.swift"),
                    "-framework", "AppKit", "-framework", "ApplicationServices",
                    "-o", str(dist / "native-save-panel-driver")], check=True, timeout=60)

subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-Wall", "-Wextra", "-Werror",
                str(root / "tools/native-fixtures/profile-lease-probe.c"),
                "-o", str(dist / "native-profile-lease-probe")], check=True, timeout=30)

report = dist / "native-smoke.json"
for stale in (report, dist / "native-smoke.json.stages.json", dist / "native-download-preflight.log"):
    if stale.exists(): stale.unlink()
stdout = dist / "native-stdout.log"
stderr = dist / "native-stderr.log"
def diagnose_failure():
    # A missing report can follow a real smoke failure while its app still owns
    # sessions or a socket. Never start another app as a diagnostic retry.
    diagnostic = dist / "native-failure-process.json"
    observation = {"scope": "read_only_after_failed_smoke", "second_app_launched": False}
    resources = dist / "native-resources.json"
    try:
        if resources.exists():
            if resources.stat().st_size > 16 * 1024 * 1024:
                raise ValueError("Resource diagnostic exceeds 16 MiB")
            resources_data = json.loads(resources.read_text())
            if not isinstance(resources_data, dict) or not isinstance(resources_data.get("samples", []), list):
                raise ValueError("Resource diagnostic has an invalid sample shape")
            samples = resources_data.get("samples", [])
            observed = next((sample for sample in reversed(samples) if isinstance(sample, dict)
                             and type(sample.get("app_pid")) is int and 0 < sample["app_pid"] < 2**31), None)
            if observed:
                pid = observed["app_pid"]
                observation["last_sample"] = {key: observed.get(key) for key in
                                              ("app_pid", "sample_wall_unix_seconds", "elapsed_seconds")}
                # Read-only observation, never authority to signal a reused PID.
                try:
                    result = subprocess.run(["/bin/ps", "-p", str(pid), "-o", "pid=,ppid=,stat=,lstart=,comm="],
                                            capture_output=True, text=True, timeout=2)
                    observation["process_probe"] = {"return_code": result.returncode,
                                                    "stdout": result.stdout[:8192], "stderr": result.stderr[:2048]}
                except subprocess.TimeoutExpired:
                    observation["process_probe"] = {"timed_out": True}
    except (OSError, ValueError) as error:
        observation["diagnostics_error"] = str(error)[:2048]
    try:
        diagnostic.write_text(json.dumps(observation, indent=2) + "\n")
    except OSError as error:
        print("Failure diagnostic could not be retained: " + str(error)[:2048])
    print("Preserving original smoke failure; no diagnostic app relaunch. See " + str(diagnostic))
    for directory in [Path.home() / "Library/Logs/DiagnosticReports", Path("/Library/Logs/DiagnosticReports")]:
        if directory.exists():
            for path in sorted(directory.glob("zmux-app*"))[-4:]:
                target = dist / ("native-crash-" + path.name + ".log")
                try:
                    target.write_text(path.read_text(errors="replace"))
                    print(target.read_text()[:24_000])
                except OSError as error:
                    print("Crash diagnostic could not be retained: " + str(error)[:2048])
@contextlib.contextmanager
def local_tmux_fixture():
    binary = shutil.which("tmux")
    if binary is None:
        raise SystemExit("Packaged local tmux acceptance requires an installed tmux executable")
    # Keep HOME and the user's actual installation untouched. This is the same
    # explicit profile configuration supported by production CLI/native hosts.
    with tempfile.TemporaryDirectory(prefix="zmt-native-", dir="/tmp") as directory:
        profile = Path(directory).resolve() / "profile"
        native_environment = dict(os.environ, ZMUX_LOCAL_TMUX_ROOT=str(profile), ZMUX_LOCAL_TMUX_BIN=binary)
        try:
            listing = json.loads(subprocess.check_output([str(bundle / "Resources/bin/zmux"), "local-tmux", "list"],
                                                         env=native_environment, text=True, timeout=10))
            if listing["socket_path"] != str(profile / "server.sock") or listing["server_running"] or listing["sessions"]:
                raise RuntimeError("Refusing to launch native smoke against an unexpected/nonempty tmux profile")
            yield native_environment
        finally:
            socket = profile / "server.sock"
            if socket.exists():
                result = subprocess.run([binary, "-N", "-f", "/dev/null", "-S", str(socket), "kill-server"],
                                        capture_output=True, text=True, timeout=10)
                if result.returncode and "no server running" not in result.stderr and "No such file" not in result.stderr:
                    raise RuntimeError("Owned native tmux fixture cleanup failed: " + result.stderr)

@contextlib.contextmanager
def browser_fixture():
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.startswith("/download"):
                if self.path == "/download-redirect":
                    self.send_response(302)
                    self.send_header("Location", "/download-cookie")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                if self.path == "/download-cookie" and "zmuxDownload=allowed" not in self.headers.get("Cookie", ""):
                    self.send_response(403)
                    self.send_header("Content-Type", "text/html")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                body = b"zmux-native-download\x00\xff\x01"
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                if self.path != "/download-mime":
                    self.send_header("Content-Disposition", 'attachment; filename="fixture.bin"')
                slow = self.path == "/download-slow"
                broken = self.path == "/download-fail"
                self.send_header("Content-Length", str(100000 if broken else len(body) * (100 if slow else 1)))
                self.end_headers()
                try:
                    for _ in range(100 if slow else 1):
                        self.wfile.write(body)
                        self.wfile.flush()
                        if slow: time.sleep(0.05)
                except (BrokenPipeError, ConnectionResetError):
                    # An actual native cancellation is expected to close the peer.
                    pass
                if broken: self.close_connection = True
                return
            second = self.path == "/second"
            title = "CSP fixture" if self.path == "/csp" else ("Second fixture" if second else "First fixture")
            body = (f"<!doctype html><title>{title}</title><main><h1>{title}</h1>"
                    "<label for='entry'>Entry</label><input id='entry' value='initial'>"
                    "<input id='checked' type='checkbox' checked><button id='button'>Continue</button>"
                    "<a href='/second'>Next page</a></main>").encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            if self.path == "/csp":
                self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'self'")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        def log_message(self, *_):
            pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    worker = threading.Thread(target=server.serve_forever, daemon=True)
    worker.start()
    (dist / "native-browser-fixture.json").write_text(json.dumps({"origin": f"http://127.0.0.1:{server.server_port}"}))
    try:
        yield
    finally:
        server.shutdown()
        server.server_close()
        worker.join(timeout=2)

with local_tmux_fixture() as native_environment, browser_fixture(), fixture_module.native_ssh_fixture(dist / "native-ssh-fixture.json", dist / "native-sshd.log"):
    sampler = resource_module.NativeResourceSampler(
        bundle / "MacOS/zmux-app", bundle / "Resources/bin/zmux",
        dist / "native-resources.json", info.get("ZmuxSourceSHA"),
    )
    try:
        try:
            sampler.start()
            subprocess.run(["/usr/bin/open","-n","-W","--stdout",str(stdout),"--stderr",str(stderr),
                            "--env", "ZMUX_LOCAL_TMUX_ROOT=" + native_environment["ZMUX_LOCAL_TMUX_ROOT"],
                            "--env", "ZMUX_LOCAL_TMUX_BIN=" + native_environment["ZMUX_LOCAL_TMUX_BIN"],
                            "--env", "ZMUX_NATIVE_SKIP_ACCESSIBILITY_SAVE_TESTS=" + ("1" if args.skip_accessibility_save_tests else "0"),
                            str(dist / "zmux.app"),"--args","--smoke-test",str(report)],check=True,timeout=180)
        finally:
            sampler.stop()
    except Exception as error:
        for path in [stdout,stderr]:
            if path.exists(): print(path.read_text())
        if isinstance(error, subprocess.TimeoutExpired):
            print("Launch Services smoke timed out; its app may remain alive.")
        diagnose_failure()
        raise
    if not report.exists():
        for path in [stdout,stderr]:
            if path.exists(): print(path.read_text())
        diagnose_failure()
        raise SystemExit("The packaged app did not produce native smoke evidence")
evidence = json.loads(report.read_text())
metadata = json.loads((dist / "build-info.json").read_text())
if evidence.get("source_sha") != metadata["source_sha"]: raise SystemExit("Smoke evidence does not match packaged source SHA")
for key in ["success","remote_file_url_symlink","remote_file_url_directory_refusal","workspace_metadata","workspace_pull_request_metadata","workspace_todo_metadata","native_input","terminal_special_keys","ansi_color","split_panes","kernel_resize","workspace_switch","workspace_order","surface_order","workspace_number","pane_close","active_terminal_title","native_cloud_callback","clipboard_image_preparation","clipboard_image_pasteboard","clipboard_image_local_paste","clipboard_image_remote_transfer","clipboard_image_remote_shell_path","clipboard_image_remote_source_lifetime","clipboard_image_remote_source_cleanup","clipboard_image_remote_managed_connection","clipboard_image_remote_focus_retained","bundled_cli_control","accessible_icon_controls","terminal_tab_shortcut","close_tab_shortcut","reopen_tab_shortcut","sibling_process_preserved","sidebar_toggle","sidebar_resize","notification_inbox","notification_target_routing","embedded_webkit","browser_hidden_state","balanced_browser_split","split_ratio_retained","tab_navigation_shared_actions","workspace_navigation_shortcuts","directional_pane_focus_shortcuts","directional_split_up","pane_reopen_original_split_anchor","global_focus_history_shortcuts","browser_directional_focus","browser_cli_automation","browser_page_zoom","browser_fill","browser_click","browser_interactions","browser_edit_scroll","browser_keyboard","browser_locators_waits","browser_profiles_isolation_reopen","browser_profile_menu","browser_profile_management","browser_downloads_cancel_native","local_tmux_cli_native_reopen","browser_never_selected_viewport","browser_csp_eval_once","browser_title_observation","notification_permission_ordering","notification_cli_metadata","notification_workspace_target","notification_jump_to_unread","notification_reply_pty"]:
    if evidence.get(key) is not True: raise SystemExit(f"Native check failed: {key}")
expected_save_state = "skipped_user_deferred" if args.skip_accessibility_save_tests else "passed"
if evidence.get("native_save_dialog_accessibility") != expected_save_state:
    raise SystemExit("Save-dialog evidence does not match the explicitly selected validation scope")
if evidence.get("browser_downloads_native") is not (not args.skip_accessibility_save_tests):
    raise SystemExit("Save-dependent download checks must not be reported passed when skipped")
print(json.dumps(evidence,indent=2))
