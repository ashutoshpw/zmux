#!/usr/bin/env python3
"""Verify last-main-window save/reopen using one isolated packaged app at a time."""
from pathlib import Path
import json
import platform
import subprocess
import tempfile


def validate_saved(profile, prepared, prepared_path):
    path = profile / "session.json"
    saved = json.loads(path.read_text())
    assert saved["version"] == 4, saved
    assert saved["identity_namespace"].lower() == prepared["namespace"].lower()
    layout = saved["window_layout"]
    assert layout["focused_window"] == prepared["window"]
    assert layout["windows"] == [{
        "id": prepared["window"], "workspace_ids": [prepared["workspace"]],
        "selected_workspace": prepared["workspace"],
    }], layout
    assert saved["focused_workspace"] == prepared["workspace"]
    assert len(saved["workspaces"]) == 1
    workspace = saved["workspaces"][0]
    assert workspace["id"] == prepared["workspace"]
    def leaves(tree):
        if tree["kind"] == "leaf":
            return [tree["pane"]]
        return leaves(tree["first"]) + leaves(tree["second"])
    panes = leaves(workspace["root"])
    assert len(panes) == 2, "Move journey must retain its native split topology"
    pane = next(pane for pane in panes if pane["id"] == workspace["focused_pane"])
    assert pane["selected_surface"] == prepared["surface"]
    assert any(surface["id"] == prepared["surface"] for surface in pane["surfaces"])
    assert path.stat().st_mtime_ns >= prepared_path.stat().st_mtime_ns, "No final save after close preparation"


def main():
    if platform.system() != "Darwin":
        raise SystemExit("Packaged native window acceptance requires macOS")
    root = Path(__file__).resolve().parent.parent
    dist = root / "dist"
    bundle = dist / "zmux.app"
    metadata = json.loads((dist / "build-info.json").read_text())
    # Keep failure evidence and the owned profile; never remove storage while an
    # app from a timed-out Launch Services invocation might still be using it.
    directory = Path(tempfile.mkdtemp(prefix="zmw-", dir="/tmp")).resolve()
    profile = directory / "profile"
    prepared_path = directory / "prepared.json"
    socket = directory / "control.sock"
    print(f"Native window fixture: {directory}", flush=True)
    def preserve_phase(phase, inspect_processes=False):
        parts = ["fixture_directory=" + str(directory)]
        for name in [f"{phase}-stdout.log", f"{phase}-stderr.log", "prepared.json", "prepared.json.trace.log", "prepared.json.reopened.json"]:
            path = directory / name
            if path.is_file():
                with path.open("rb") as stream:
                    stream.seek(max(0, path.stat().st_size - 65536))
                    data = stream.read(65536)
                target = dist / ("native-window-" + name)
                target.write_bytes(data)
                parts.append(name + "\n" + data.decode(errors="replace"))
        if inspect_processes:
            try:
                processes = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid=,stat=,comm="],
                                           capture_output=True, text=True, check=True, timeout=5)
                parts.append("public_process_snapshot\n" + "\n".join(line for line in processes.stdout.splitlines() if "zmux-app" in line)[-65536:])
            except Exception as error:
                parts.append("process_snapshot_failed=" + repr(error))
        (dist / ("native-window-" + phase + "-diagnostics.log")).write_text("\n".join(parts)[-262144:])

    for phase in ["close", "reopen"]:
        stdout = directory / f"{phase}-stdout.log"
        stderr = directory / f"{phase}-stderr.log"
        command = ["/usr/bin/open", "-n", "-W", "--stdout", str(stdout), "--stderr", str(stderr),
                   "--env", "ZMUX_SOCKET=" + str(socket), str(bundle), "--args",
                   "--window-lifecycle-smoke", str(prepared_path), str(profile), phase]
        try:
            subprocess.run(command, check=True, timeout=150)
        except Exception:
            preserve_phase(phase, inspect_processes=True)
            for path in [stdout, stderr]:
                if path.exists():
                    print(path.read_text(errors="replace")[-65536:])
            print(f"Native window phase {phase} failed; profile retained at {directory}. No second app was launched.")
            raise
        preserve_phase(phase)
        if phase == "close":
            if not prepared_path.is_file():
                preserve_phase(phase, inspect_processes=True)
                for path in [stdout, stderr]:
                    if path.exists():
                        print(path.read_text(errors="replace")[-65536:])
                raise RuntimeError("The native close journey produced no preparation receipt; no second app was launched")
            prepared = json.loads(prepared_path.read_text())
            assert prepared["sourceSHA"] == metadata["source_sha"]
            for key in ["noFocus", "independentResize", "nativeInput", "nativeClose", "emptyWindow", "cliClose", "workspaceMove"]:
                assert prepared[key] is True, key
            validate_saved(profile, prepared, prepared_path)
    reopened = json.loads(Path(str(prepared_path) + ".reopened.json").read_text())
    assert reopened["source_sha"] == metadata["source_sha"]
    for key in ["success", "fresh_process", "native_input", "workspace_split_ratio_restored"]:
        assert reopened[key] is True, key
    evidence = {"success": True, "source_sha": metadata["source_sha"], "prepared": prepared,
                "last_close_saved": True, "reopened": reopened, "fixture_directory": str(directory),
                "native_close_before_open_race": "separate portable real-owner gate"}
    (dist / "native-windows.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps(evidence, indent=2))


if __name__ == "__main__":
    main()
