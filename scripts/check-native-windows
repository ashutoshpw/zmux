#!/usr/bin/env python3
"""Verify last-main-window save/reopen using one isolated packaged app at a time."""
from pathlib import Path
import json
import os
import stat
import platform
import re
import subprocess
import tempfile


def validate_saved(profile, prepared, prepared_path):
    path = profile / "session.json"
    saved = json.loads(path.read_text())
    assert saved["version"] == 11, saved
    assert saved["workspace_groups"] == [], "This ungrouped window journey must preserve the v9 group field"
    assert saved["identity_namespace"].lower() == prepared["namespace"].lower()
    layout = saved["window_layout"]
    assert layout["focused_window"] == prepared["window"]
    assert layout["windows"] == [{
        "id": prepared["window"], "workspace_ids": [prepared["workspace"]],
        "selected_workspace": prepared["workspace"],
    }], layout
    assert saved["focused_workspace"] == prepared["workspace"]
    assert len(saved["workspaces"]) == 1
    workspace = saved["workspaces"][0]
    assert workspace["id"] == prepared["workspace"]
    assert workspace["todos"] == [
        {"id": prepared["todoIDs"][0].lower(), "text": "Saved pending checklist item", "state": "pending", "origin": "user"},
        {"id": prepared["todoIDs"][1].lower(), "text": "Saved completed checklist item", "state": "completed", "origin": "agent"},
    ], "Saved checklist identity/order/state/origin differs from actual close preparation"
    def leaves(tree):
        if tree["kind"] == "leaf":
            return [tree["pane"]]
        return leaves(tree["first"]) + leaves(tree["second"])
    panes = leaves(workspace["root"])
    assert len(panes) == 2, "Move journey must retain its native split topology"
    pane = next(pane for pane in panes if pane["id"] == workspace["focused_pane"])
    assert pane["selected_surface"] == prepared["surface"]
    assert any(surface["id"] == prepared["surface"] for surface in pane["surfaces"])
    assert path.stat().st_mtime_ns >= prepared_path.stat().st_mtime_ns, "No final save after close preparation"


def preserve_profile(profile, dist, phase):
    """Copy only this journey's generated, bounded private JSON and file metadata.

    Never follow a symlink or copy a lock's contents. The session document is
    generated by the isolated fixture, not the user's application profile.
    """
    records = {"profile": str(profile), "files": {}}
    for name, limit in [("session.json", 512 * 1024),
                        ("browser-profiles.json", 16 * 1024),
                        ("session-generations.json", 64 * 1024),
                        ("session-generations.lock", 0),
                        ("browser-profiles.lock", 0)]:
        path = profile / name
        record = {}
        records["files"][name] = record
        try:
            before = path.lstat()
            record.update(size=before.st_size, mode=oct(stat.S_IMODE(before.st_mode)),
                          uid=before.st_uid, gid=before.st_gid, mtime_ns=before.st_mtime_ns,
                          ctime_ns=before.st_ctime_ns, regular=stat.S_ISREG(before.st_mode),
                          symlink=stat.S_ISLNK(before.st_mode))
            if not limit:
                record["capture"] = "metadata_only"
                continue
            if not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid() or before.st_mode & 0o177 or before.st_size > limit:
                record["capture"] = "refused_unsafe_or_oversize"
                continue
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, "rb") as stream:
                opened = os.fstat(stream.fileno())
                if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
                    record["capture"] = "refused_changed_identity"
                    continue
                data = stream.read(limit + 1)
            if len(data) > limit:
                record["capture"] = "refused_oversize"
                continue
            # Preserve malformed generated JSON too: startup rejection may be
            # precisely what this evidence needs to explain.
            try:
                json.loads(data)
                record["valid_json"] = True
            except (ValueError, UnicodeDecodeError):
                record["valid_json"] = False
            target = dist / ("native-window-" + phase + "-profile-" + name)
            target.write_bytes(data)
            target.chmod(0o600)
            record["capture"] = target.name
        except FileNotFoundError:
            record["capture"] = "missing"
        except OSError as error:
            record["capture"] = "failed"
            record["error"] = str(error)[:512]
    metadata = dist / ("native-window-" + phase + "-profile-metadata.json")
    metadata.write_text(json.dumps(records, indent=2) + "\n")
    metadata.chmod(0o600)
    return records


def main():
    if platform.system() != "Darwin":
        raise SystemExit("Packaged native window acceptance requires macOS")
    root = Path(__file__).resolve().parent.parent
    dist = root / "dist"
    bundle = dist / "zmux.app"
    metadata = json.loads((dist / "build-info.json").read_text())
    # Keep failure evidence and the owned profile; never remove storage while an
    # app from a timed-out Launch Services invocation might still be using it.
    directory = Path(tempfile.mkdtemp(prefix="zmw-", dir="/tmp")).resolve()
    profile = directory / "profile"
    prepared_path = directory / "prepared.json"
    socket = directory / "control.sock"
    print(f"Native window fixture: {directory}", flush=True)
    def preserve_phase(phase, inspect_processes=False):
        parts = ["fixture_directory=" + str(directory)]
        parts.append("generated_profile_metadata\n" + json.dumps(preserve_profile(profile, dist, phase), indent=2))
        for name in [f"{phase}-stdout.log", f"{phase}-stderr.log", "prepared.json", "prepared.json.trace.log", "prepared.json.reopened.json", "prepared.json.timeout-diagnostics.json"]:
            path = directory / name
            if path.is_file():
                with path.open("rb") as stream:
                    stream.seek(max(0, path.stat().st_size - 65536))
                    data = stream.read(65536)
                target = dist / ("native-window-" + name)
                target.write_bytes(data)
                parts.append(name + "\n" + data.decode(errors="replace"))
        if inspect_processes:
            try:
                processes = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid=,stat=,comm="],
                                           capture_output=True, text=True, check=True, timeout=5)
                parts.append("public_process_snapshot\n" + "\n".join(line for line in processes.stdout.splitlines() if "zmux-app" in line)[-65536:])
            except Exception as error:
                parts.append("process_snapshot_failed=" + repr(error))
        if inspect_processes:
            # Sample only the isolated packaged process identified by its private
            # trace and current executable path. Never launch another app on failure.
            trace = directory / "prepared.json.trace.log"
            if trace.is_file():
                with trace.open("rb") as stream:
                    stream.seek(max(0, trace.stat().st_size - 65536))
                    recent_trace = stream.read(65536).decode(errors="replace")
                # Reopen appends to the same trace; use its latest process, not
                # the already exited close-phase PID at the start of the file.
                pids = re.findall(r"\[window-lifecycle pid=(\d+) ", recent_trace)
                if pids:
                    pid = pids[-1]
                    try:
                        command = subprocess.check_output(
                            ["/bin/ps", "-p", pid, "-o", "comm="], text=True, timeout=5).strip()
                        if command == str(bundle / "Contents/MacOS/zmux-app"):
                            sample = subprocess.run(
                                ["/usr/bin/sample", pid, "3", "-file", str(dist / ("native-window-" + phase + "-sample.log"))],
                                capture_output=True, text=True, timeout=10)
                            parts.append("sample_exit=" + str(sample.returncode) + "\n" + sample.stderr[-4096:])
                        else:
                            parts.append("sample_refused_unmatched_executable=" + command)
                    except (OSError, subprocess.SubprocessError) as error:
                        parts.append("sample_failed=" + repr(error))
        (dist / ("native-window-" + phase + "-diagnostics.log")).write_text("\n".join(parts)[-262144:])

    for phase in ["close", "reopen"]:
        stdout = directory / f"{phase}-stdout.log"
        stderr = directory / f"{phase}-stderr.log"
        command = ["/usr/bin/open", "-n", "-W", "--stdout", str(stdout), "--stderr", str(stderr),
                   "--env", "ZMUX_SOCKET=" + str(socket), str(bundle), "--args",
                   "--window-lifecycle-smoke", str(prepared_path), str(profile), phase]
        try:
            subprocess.run(command, check=True, timeout=150)
        except Exception:
            preserve_phase(phase, inspect_processes=True)
            for path in [stdout, stderr]:
                if path.exists():
                    print(path.read_text(errors="replace")[-65536:])
            print(f"Native window phase {phase} failed; profile retained at {directory}. No second app was launched.")
            raise
        preserve_phase(phase)
        if phase == "close":
            if not prepared_path.is_file():
                preserve_phase(phase, inspect_processes=True)
                for path in [stdout, stderr]:
                    if path.exists():
                        print(path.read_text(errors="replace")[-65536:])
                raise RuntimeError("The native close journey produced no preparation receipt; no second app was launched")
            prepared = json.loads(prepared_path.read_text())
            assert prepared["sourceSHA"] == metadata["source_sha"]
            for key in ["noFocus", "independentResize", "nativeInput", "nativeClose", "emptyWindow", "cliClose", "workspaceMove"]:
                assert prepared[key] is True, key
            validate_saved(profile, prepared, prepared_path)
        if phase == "reopen" and not Path(str(prepared_path) + ".reopened.json").is_file():
            preserve_phase(phase, inspect_processes=True)
            raise RuntimeError(
                "Native reopen journey produced no completion receipt. "
                f"See {dist / 'native-window-reopen-diagnostics.log'} and "
                f"{dist / 'native-window-reopen-stderr.log'}; generated profile retained at {profile}. "
                "No additional app was launched after this failure."
            )
    reopened = json.loads(Path(str(prepared_path) + ".reopened.json").read_text())
    assert reopened["source_sha"] == metadata["source_sha"]
    for key in ["success", "fresh_process", "native_input", "workspace_split_ratio_restored", "workspace_todos_restored", "transient_metadata_not_restored", "workspace_todo_row_rendered"]:
        assert reopened[key] is True, key
    evidence = {"success": True, "source_sha": metadata["source_sha"], "prepared": prepared,
                "last_close_saved": True, "reopened": reopened, "fixture_directory": str(directory),
                "native_close_before_open_race": "separate portable real-owner gate"}
    (dist / "native-windows.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps(evidence, indent=2))


if __name__ == "__main__":
    main()
