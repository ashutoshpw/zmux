#!/usr/bin/env python3
"""Run generated profiles through the packaged production owner and fresh readers."""
from pathlib import Path
import fcntl
import hashlib
import http.server
import json
import os
import platform
import stat
import subprocess
import tempfile
import threading


def main():
    if platform.system() != "Darwin":
        raise SystemExit("Packaged profile acceptance requires macOS")
    root = Path(__file__).resolve().parent.parent
    dist = root / "dist"
    bundle = dist / "zmux.app"
    executable = bundle / "Contents/MacOS/zmux-app"
    metadata = json.loads((dist / "build-info.json").read_text())
    directory = Path(tempfile.mkdtemp(prefix="zmp-", dir="/tmp")).resolve()
    directory.chmod(0o700)
    report = directory / "acceptance.json"
    profile = directory / "profile"
    socket = directory / "control.sock"
    environment = {key: value for key, value in os.environ.items()
                   if not key.startswith(("ZMUX_", "DYLD_"))
                   and key not in ("RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS")}
    environment.update(ZMUX_SOCKET=str(socket), ZMUX_SOCKET_PATH=str(socket))
    subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-Wall", "-Wextra", "-Werror",
                    str(root / "tools/native-fixtures/profile-lease-holder.c"), "-o",
                    str(dist / "native-profile-lease-holder")], env=environment, check=True, timeout=30)

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            download = self.path == "/download"
            body = b"profile-acceptance-download\0\xff" if download else b"<!doctype html><title>Profile acceptance</title><main>Generated profile fixture</main>"
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream" if download else "text/html; charset=utf-8")
            if download:
                self.send_header("Content-Disposition", 'attachment; filename="profile-fixture.bin"')
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass  # The actual Save sheet's cancellation may close its peer.

        def log_message(self, *_):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    worker = threading.Thread(target=server.serve_forever, daemon=True)
    worker.start()
    origin = f"http://127.0.0.1:{server.server_port}"
    phases = []

    def preserve():
        # Only this generated, bounded private fixture is copied. Website data,
        # global lease contents and the user's application profile are excluded.
        for path in directory.iterdir():
            if path.is_file() and (path.suffix == ".log" or path.stat().st_size <= 262144):
                target = dist / ("native-profiles-" + path.name)
                with path.open("rb") as stream:
                    stream.seek(max(0, path.stat().st_size - 262144))
                    target.write_bytes(stream.read(262144))
                target.chmod(0o600)
        for name in ["browser-profiles.json", "session.json"]:
            path = profile / name
            if path.is_file() and path.stat().st_size <= 524288:
                target = dist / ("native-profiles-" + name)
                target.write_bytes(path.read_bytes())
                target.chmod(0o600)

    def released_leases():
        saved = json.loads(Path(str(report) + ".state.json").read_text())
        lease_root = Path(saved["leaseRoot"])
        records = []
        for key in ["a", "b", "c"]:
            path = lease_root / ("browser-profile-" + saved[key].lower() + ".lock")
            descriptor = os.open(path, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
            try:
                identity = os.fstat(descriptor)
                assert stat.S_ISREG(identity.st_mode) and identity.st_uid == os.getuid()
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                assert identity.st_size == 0, "Original physical quarantine cleanup is unconfirmed"
                records.append({"profile": saved[key], "device": identity.st_dev,
                                "inode": identity.st_ino, "size": identity.st_size,
                                "exclusive_after_original_pid_reaped": True})
            finally:
                os.close(descriptor)
        return records

    print("Generated production profile acceptance: " + str(directory), flush=True)
    try:
        for phase in ["prepare", "reader", "verify"]:
            output = directory / (phase + ".stdout.log")
            errors = directory / (phase + ".stderr.log")
            command = [str(executable), "--profile-operations-smoke", str(report), str(profile), phase, origin]
            with output.open("wb") as stdout, errors.open("wb") as stderr:
                # Own the actual packaged executable PID. wait() is an actual
                # original-child exit/reap, independent of Launch Services.
                process = subprocess.Popen(command, env=environment, stdin=subprocess.DEVNULL,
                                           stdout=stdout, stderr=stderr)
                try:
                    status = process.wait(timeout=240)
                except subprocess.TimeoutExpired:
                    preserve()
                    raise RuntimeError(f"Original {phase} PID {process.pid} did not exit. No second app launched; fixture retained at {directory}")
            preserve()
            if status != 0:
                raise RuntimeError(f"Original {phase} PID {process.pid} failed ({status}); no next app launched. " + errors.read_text(errors="replace")[-32768:])
            result_path = Path(str(report) + "." + phase + ".json")
            result = json.loads(result_path.read_text())
            assert result["pid"] == process.pid and result["source_sha"] == metadata["source_sha"]
            assert result["success"] is True and result["shutdown_complete"] is True
            phases.append({"phase": phase, "original_pid": process.pid, "normal_exit_status": status,
                           "original_pid_waited_and_reaped": True, "native": result,
                           "released_leases": released_leases()})
            preserve()
        evidence = {"success": True, "source_sha": metadata["source_sha"], "phases": phases,
                    "fixture_directory": str(directory), "packaged_executable_sha256": hashlib.sha256(executable.read_bytes()).hexdigest(),
                    "launch_environment": "Inherited ZMUX_ and DYLD_ values removed; exact private ZMUX_SOCKET/ZMUX_SOCKET_PATH supplied",
                    "download_scope": "Actual WKDownload conversion, refusal with live tab, real Save Cancel and physical cleanup; no Save acceptance or download-only guard isolation",
                    "unexercised": ["missing callback and interrupted nonterminal reconciliation fault injection",
                                    "deterministic constructor-during-restore race",
                                    "download/conversion-only refusal without a simultaneous model/native view guard"]}
        (dist / "native-profile-operations.json").write_text(json.dumps(evidence, indent=2) + "\n")
        print(json.dumps(evidence, indent=2))
    finally:
        preserve()
        server.shutdown()
        server.server_close()
        worker.join(timeout=2)


if __name__ == "__main__":
    main()
