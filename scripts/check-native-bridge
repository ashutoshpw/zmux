#!/usr/bin/env python3
"""Compile a foreign C caller and validate its actual bridge responses."""
from pathlib import Path
import json
import os
import tempfile
from importlib.util import module_from_spec, spec_from_file_location
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
subprocess.run(["cargo", "build", "--locked", "-p", "zmux-native-bridge"], cwd=root, check=True)
metadata = json.loads(subprocess.check_output(["cargo", "metadata", "--locked", "--no-deps", "--format-version", "1"], cwd=root, text=True))
libdir = Path(metadata["target_directory"]) / "debug"
executable = libdir / "zmux-native-abi-check"
subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-Wall", "-Wextra", "-Werror",
                "-I", str(root / "crates/native-bridge/include"), str(root / "crates/native-bridge/tests/abi.c"),
                "-L", str(libdir), "-lzmux_native_bridge", f"-Wl,-rpath,{libdir}", "-o", str(executable)], check=True)
environment = os.environ.copy()
# The ABI test owns its shell behavior; user zsh startup files can otherwise consume or
# delay input before the test command reaches an interactive prompt.
environment["SHELL"] = "/bin/sh"
result = subprocess.run([str(executable)], capture_output=True, text=True, env=environment)
if result.returncode != 0:
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    raise SystemExit(f"C ABI executable failed with status {result.returncode}")
responses = [json.loads(line) for line in result.stdout.splitlines()]
assert len(responses) == 7, responses
assert responses[0]["error"]["code"] == "unsupported_version"
assert responses[1]["error"]["code"] == "invalid_request"
created = responses[2]
assert created["ok"] and created["version"] == 1
assert created["snapshot"]["revision"] == 1
assert created["snapshot"]["workspaces"][0]["name"] == "from-C"
assert len(created["effects"]) == 1 and created["effects"][0]["effect"] == "start_session"
assert responses[3]["error"]["code"] == "action_rejected"
assert responses[4]["error"]["code"] == "invalid_request"
assert responses[5]["snapshot"] == created["snapshot"]
assert responses[6]["snapshot"]["revision"] == 0 and responses[6]["snapshot"]["workspaces"] == []
print("C ABI checks passed: wire decoding, ownership, stale handles, bounded copy, and capacity-before-mutation.")

lease_executable = libdir / "zmux-native-profile-lease-check"
subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-Wall", "-Wextra", "-Werror",
                "-I", str(root / "crates/native-bridge/include"), str(root / "crates/native-bridge/tests/profile_leases.c"),
                "-L", str(libdir), "-lzmux_native_bridge", f"-Wl,-rpath,{libdir}", "-o", str(lease_executable)], check=True)
runner_spec = spec_from_file_location("profile_lease_owned_process_runner", root / "tools/terminal-feasibility/run.py")
runner = module_from_spec(runner_spec)
runner_spec.loader.exec_module(runner)
phases = []
with tempfile.TemporaryDirectory(prefix="zmux-native-lease-", dir=libdir) as lease_fixture:
    canonical_fixture = Path(lease_fixture).resolve(strict=True)
    lease_output = runner.run([str(lease_executable), str(canonical_fixture)], "profile-lease-abi", libdir, phases,
                              timeout=30, cwd=root, env=environment)
    assert phases[-1]["log_bytes_seen"] == phases[-1]["log_bytes_retained"]
    assert lease_output.strip() == "native_profile_lease_passed"
print("Native profile lease C ABI passed: capacity before acquisition, independent-process contention, original-owner status and lease retention after Desktop shutdown.")

message_executable = libdir / "zmux-native-agent-message-check"
subprocess.run([os.environ.get("CC", "cc"), "-std=c11", "-Wall", "-Wextra", "-Werror",
                "-I", str(root / "crates/native-bridge/include"), str(root / "crates/native-bridge/tests/agent_messages.c"),
                "-L", str(libdir), "-lzmux_native_bridge", f"-Wl,-rpath,{libdir}", "-o", str(message_executable)], check=True)
with tempfile.TemporaryDirectory(prefix="zmux-native-message-", dir=libdir) as message_fixture:
    message_output = runner.run([str(message_executable), str(Path(message_fixture).resolve(strict=True))],
                                "agent-message-abi", libdir, [], timeout=30, cwd=root, env=environment)
    receipts = [json.loads(line) for line in message_output.splitlines()]
    assert len(receipts) == 4
    for index, request_id in ((0, 1), (1, 3)):
        reply = receipts[index]
        expected = f"00000000-0000-4000-8000-{request_id:012d}"
        assert reply["ok"] and reply["request_id"] == expected
        assert reply["receipt"]["request_id"] == expected and reply["receipt"]["state"] == "completed"
        assert reply["receipt"]["result"]["enabled"] is False
        assert reply["receipt"]["result"]["effective_enabled"] is False
    assert receipts[2]["ok"] and receipts[2]["receipt"]["state"] == "unknown_or_expired"
    assert receipts[2]["request_id"] == "00000000-0000-4000-8000-000000000002"
    assert not receipts[3]["ok"] and receipts[3]["outcome_unknown"] is False
print("Native inbox C ABI passed: exact UUID receipts, strict host capability, stale origin and capacity refusal without settings mutation.")
