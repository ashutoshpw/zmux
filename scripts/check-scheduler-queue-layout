#!/usr/bin/env python3
"""Compile the production scheduler queue owner and check native viewport resizing."""
from pathlib import Path
import platform
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
if platform.system() != "Darwin":
    raise SystemExit("Scheduler queue layout requires macOS/AppKit")
output = root / "dist"
output.mkdir(exist_ok=True)
source = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
with tempfile.TemporaryDirectory(prefix="zmux-queue-layout-") as directory:
    executable = Path(directory) / "layout"
    subprocess.run([
        "xcrun", "swiftc", "-parse-as-library", "-swift-version", "6",
        "-strict-concurrency=complete", "-warnings-as-errors", "-O",
        str(root / "apps/macos/Sources/ScheduleQueueView.swift"),
        str(root / "apps/macos/Sources/ScheduleMessagesView.swift"),
        str(root / "tools/native-fixtures/scheduler-queue-layout.swift"),
        "-framework", "AppKit", "-o", str(executable),
    ], check=True, timeout=90)
    subprocess.run([str(executable), str(output / "native-scheduler-queue-layout.json"), source],
                   check=True, timeout=30)
